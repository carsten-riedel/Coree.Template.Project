{
  "$schema": "https://json.schemastore.org/ide.host",
  "symbolInfo": [
    {
      "id": "InitDefaultRepoItems",
      "isVisible": true,
      "defaultValue": "Readme|AIReleaseCheckpoint|GitAttributes",
      "persistenceScope": "none",
      "name": {
        "text": "Repository root items"
      },
      "description": {
        "text": "Root files for the first create. Visual Studio requires at least one value; choose None when adding another library to the same repository."
      }
    },
    {
      "id": "PlaceSolutionInSolutionFolder",
      "isVisible": true,
      "persistenceScope": "none",
      "name": {
        "text": "Place solution in src/sln folder"
      },
      "description": {
        "text": "Puts each .slnx next to that library's notes under src/sln/{name}/ so multiple libraries do not share one directory. Visual Studio also creates a root .slnx; close Visual Studio, open the src/sln solution, and delete the extra root .slnx."
      }
    },
    {
      "id": "TargetFrameworks",
      "isVisible": true
    },
    {
      "id": "UseWebSdk",
      "isVisible": true
    },
    {
      "id": "UiSepVisRocket20",
      "isVisible": true,
      "defaultValue": "true",
      "persistenceScope": "none",
      "name": {
        "text": "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500[ \uD83D\uDE80 ]\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"
      },
      "description": {
        "text": "Separators are not available in templates. This checkbox has no effect."
      }
    },
    {
      "id": "CSharpProjectOptions",
      "isVisible": true,
      "defaultValue": "DisableImplicitUsings|Nullable|LangLatest|DebugEmbedded|GenerateDocumentationFile",
      "persistenceScope": "none",
      "name": {
        "text": "C# project options"
      },
      "description": {
        "text": "Checked values write explicit C# and debug properties on the class library, tests, and benchmark. XML documentation is library-only. Uncheck one to write the alternative."
      }
    },
    {
      "id": "PackageAuthor",
      "isVisible": true
    },
    {
      "id": "PackageCopyrightHolder",
      "isVisible": true
    },
    {
      "id": "PackageCopyrightHolderIsOrganization",
      "isVisible": true
    },
    {
      "id": "PackageDescription",
      "isVisible": true
    },
    {
      "id": "ProjectLicense",
      "isVisible": true,
      "defaultValue": "MIT",
      "persistenceScope": "none",
      "name": {
        "text": "Project license"
      },
      "description": {
        "text": "Default MIT. Standard licenses set PackageLicenseExpression and keep License.txt on disk. Custom packs License.txt as the NuGet license file. Repository root LICENSE is the separate checkbox."
      }
    },
    {
      "id": "UseProjectLicenseAsRepoLicense",
      "isVisible": true,
      "persistenceScope": "none",
      "name": {
        "text": "Use project license as repository license"
      },
      "description": {
        "text": "Also write LICENSE at the repository root. First create only."
      }
    },
    {
      "id": "ProjectEditorGlobalConfig",
      "isVisible": true
    },
    {
      "id": "CoverletMSBuild",
      "isVisible": true
    },
    {
      "id": "ReportGenerator",
      "isVisible": true
    },
    {
      "id": "BenchmarkProject",
      "isVisible": true
    }
  ]
}
