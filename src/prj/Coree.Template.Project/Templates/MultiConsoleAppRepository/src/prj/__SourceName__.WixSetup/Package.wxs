<!-- The MSI publisher follows the organization when one is supplied, otherwise the author. -->
<!--#if ((PackageCopyrightHolderIsOrganization == true) && PackageCopyrightHolderIsSet) -->
<?define InstallerManufacturer = "MyCopyrightHolder" ?>
<!--#else -->
<?define InstallerManufacturer = "MyAuthor" ?>
<!--#endif -->
<!-- Feature level 1 is selected by default; level 2 is offered but initially absent. -->
<?if $(DesktopShortcutSelectedByDefault) = "true" ?>
<?define DesktopShortcutInstallLevel = 1 ?>
<?else?>
<?define DesktopShortcutInstallLevel = 2 ?>
<?endif?>
<?if $(AddToUserPathSelectedByDefault) = "true" ?>
<?define UserPathInstallLevel = 1 ?>
<?else?>
<?define UserPathInstallLevel = 2 ?>
<?endif?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Id="__SourceName__.WixSetup"
    Name="__SourceName__ (User)"
    Manufacturer="$(InstallerManufacturer)"
    Version="!(bind.fileVersion.MainExecutable)"
    UpgradeCode="00000000-0000-0000-0000-000000000001"
    Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer version of __SourceName__ is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <!-- The setup icon appears in Windows Installed apps; it is not installed beside the app. -->
    <Icon Id="SetupIcon.ico" SourceFile="$(sys.SOURCEFILEDIR)SetupAssets\Icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="SetupIcon.ico" />
    <!-- The feature picker offers install-time choices; Minimal remains for neither choice. -->
    <?if $(OfferDesktopShortcut) = "true" or $(OfferAddToUserPath) = "true" ?>
    <ui:WixUI Id="WixUI_FeatureTree" />
    <?else?>
    <ui:WixUI Id="WixUI_Minimal" />
    <?endif?>
    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)SetupAssets\License.rtf" />
    <?if $(OfferRunAfterInstall) = "true" ?>
    <!-- Launch is an after-install action; its checkbox has an independent default. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Run __SourceName__" />
    <?if $(RunAfterInstallSelectedByDefault) = "true" ?>
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <?endif?>
    <CustomAction Id="RunAfterInstall" FileRef="MainExecutable" ExeCommand="" Return="asyncNoWait" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="RunAfterInstall" Order="1" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <?endif ?>
    <StandardDirectory Id="PerUserProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="__SourceName__" />
    </StandardDirectory>
    <!-- The app is required. Its EXE supplies the MSI version; harvest all other publish files. -->
    <Feature Id="MainApplication" Title="Application" Level="1" AllowAbsent="no" Display="expand">
      <File Id="MainExecutable" Source="!(bindpath.__SourceName__)\__SourceName__.exe" Directory="INSTALLFOLDER" />
      <Files Include="!(bindpath.__SourceName__)\**" Directory="INSTALLFOLDER">
        <Exclude Files="!(bindpath.__SourceName__)\__SourceName__.exe" />
      </Files>
      <?if $(OfferDesktopShortcut) = "true" ?>
      <!-- Keep the shortcut optional; target the required app through its install directory. -->
      <!-- A file-key target would cross feature/component boundaries and fail ICE69. -->
      <Feature Id="DesktopShortcutFeature" Title="Desktop shortcut" Level="$(DesktopShortcutInstallLevel)" AllowAdvertise="no">
        <Component Id="DesktopShortcutComponent" Directory="DesktopFolder" Guid="*">
          <Shortcut Id="DesktopShortcut" Name="__SourceName__" Target="[INSTALLFOLDER]__SourceName__.exe" WorkingDirectory="INSTALLFOLDER" />
          <RegistryValue Root="HKCU" Key="Software\__SourceName__\Installer" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Feature>
      <?endif?>
      <?if $(OfferAddToUserPath) = "true" ?>
      <!-- Append only the install directory to the user's PATH; MSI removes it on uninstall. -->
      <Feature Id="UserPathFeature" Title="Add to user PATH" Level="$(UserPathInstallLevel)" AllowAdvertise="no">
        <Component Id="UserPathComponent" Directory="INSTALLFOLDER" Guid="*">
          <Environment Id="UserPath" Name="PATH" Action="set" Part="last" System="no" Permanent="no" Value="[INSTALLFOLDER]" />
          <RegistryValue Root="HKCU" Key="Software\__SourceName__\Installer" Name="UserPath" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Feature>
      <?endif?>
    </Feature>
  </Package>
</Wix>
