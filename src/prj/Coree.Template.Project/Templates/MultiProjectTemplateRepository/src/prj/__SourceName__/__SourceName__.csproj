<Project Sdk="Microsoft.NET.Sdk">

  <!-- General build settings: defines the output type and target framework -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>

  <!-- C# language features and debugging configuration -->
  <PropertyGroup>
    <!--#if (CSharpProjectOptions == "DisableImplicitUsings") -->
    <ImplicitUsings>disable</ImplicitUsings>
    <!--#else -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!--#endif -->
    <!--#if (CSharpProjectOptions == "Nullable") -->
    <Nullable>enable</Nullable>
    <!--#else -->
    <Nullable>disable</Nullable>
    <!--#endif -->
    <!--#if (CSharpProjectOptions == "DebugEmbedded") -->
    <DebugType>embedded</DebugType>
    <!--#else -->
    <DebugType>none</DebugType>
    <!--#endif -->
    <!--#if (CSharpProjectOptions == "LangLatest") -->
    <LangVersion>latest</LangVersion>
    <!--#else -->
    <LangVersion>default</LangVersion>
    <!--#endif -->
  </PropertyGroup>

  <!--#if (NuGetAuditHighCriticalAsErrors) -->
  <!-- Restore NuGetAudit is already on. High (NU1903) and critical (NU1904) fail restore. Low/moderate stay warnings. -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
  <!--#endif -->

  <!-- Packaging configuration -->
  <!-- EnablePackageValidation: TFM/runtime holes on pack. No baseline at generate; set PackageValidationBaselineVersion after the first nuget.org publish. -->
  <PropertyGroup>
    <IncludeBuildOutput>False</IncludeBuildOutput>
    <IncludeSource>False</IncludeSource>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <EnableDefaultItems>False</EnableDefaultItems>
    <IsPackable>true</IsPackable>
    <IsPublishable>false</IsPublishable>
    <PackAsTool>false</PackAsTool>
    <EnablePackageValidation>true</EnablePackageValidation>
    <IsShipping>false</IsShipping>
    <NoWarn>2008;NU5105</NoWarn>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <SuppressDependenciesWhenPacking>True</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <PackageType>Template</PackageType>
    <!-- Suppress creation of contentFiles directory -->
    <ContentTargetFolders>.\</ContentTargetFolders>
  </PropertyGroup>

  <!--#if (UseNerdbankGitVersioning) -->
  <!-- Versioning: Nerdbank -->
  <!--#if (NerdbankGitVersioning == "Project") -->
  <PropertyGroup>
    <GitVersionBaseDirectory>$(MSBuildProjectDirectory)\Properties</GitVersionBaseDirectory>
  </PropertyGroup>
  <!--#endif -->
  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.10.94">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <!--#else -->
  <!-- Versioning -->
  <PropertyGroup>
    <VersionMajor>0</VersionMajor>
    <VersionMinor>1</VersionMinor>
    <VersionBuild>0</VersionBuild>
    <VersionRevision>0</VersionRevision>
    <VersionPrefix>$(VersionMajor).$(VersionMinor).$(VersionBuild).$(VersionRevision)</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == '' and '$(Configuration)' == 'Debug'">prerelease</VersionSuffix>
    <PackageVersion Condition="'$(VersionSuffix)' == ''">$(VersionPrefix)</PackageVersion>
    <PackageVersion Condition="'$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</PackageVersion>
    <InformationalVersion>$(PackageVersion)</InformationalVersion>
    <AssemblyVersion>$(VersionPrefix)</AssemblyVersion>
  </PropertyGroup>
  <!--#endif -->

  <!-- Package metadata -->
  <!-- https://learn.microsoft.com/en-us/nuget/create-packages/package-authoring-best-practices -->
  <PropertyGroup>
    <Authors>MyAuthor</Authors>
    <!--#if (PackageCopyrightHolderIsSet) -->
    <Owners>MyCopyrightHolder</Owners>
    <!--#else -->
    <Owners>MyAuthor</Owners>
    <!--#endif -->
    <!--#if (PackageCopyrightHolderIsOrganization == true) -->
    <!--#if (PackageCopyrightHolderIsSet) -->
    <Company>MyCopyrightHolder</Company>
    <!--#else -->
    <Company>MyAuthor</Company>
    <!--#endif -->
    <!--#else -->
    <Company></Company>
    <!--#endif -->
    <!--#if (PackageCopyrightHolderIsSet) -->
    <Copyright>Copyright © 1975 MyCopyrightHolder</Copyright>
    <!--#else -->
    <Copyright>Copyright © 1975 MyAuthor</Copyright>
    <!--#endif -->
    <PackageId>__SourceName__</PackageId>
    <PackageTags>dotnet;class;library</PackageTags>
    <PackageProjectUrl></PackageProjectUrl>
    <RepositoryUrl></RepositoryUrl>
    <RepositoryType></RepositoryType>
    <!-- NuGet gallery blurb. CDATA is optional and keeps multiline text. -->
    <Description><![CDATA[]]></Description>
    <PackageReadmeFile>Readme.md</PackageReadmeFile>
    <!--#if (ProjectLicense == "MIT") -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!--#endif -->
    <!--#if (ProjectLicense == "BSD3Clause") -->
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <!--#endif -->
    <!--#if (ProjectLicense == "Apache2") -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <!--#endif -->
    <!--#if (ProjectLicense == "Custom") -->
    <PackageLicenseFile>License.txt</PackageLicenseFile>
    <!--#endif -->
    <PackageIcon>Icon-128x128.png</PackageIcon>
    <!-- Read multiline release notes from a separate source file so this project file stays compact. -->
    <PackageReleaseNotes>$([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)\Properties\NugetMetadata\PackageReleaseNotes.txt"))</PackageReleaseNotes>
  </PropertyGroup>

  <!-- Package specs -->
  <!-- NuGet template layout. Exclude bin/obj/.vs (VS can create those if an slnx is opened)
       and maintainer markdown under .template.config (not template content, not shipped). -->
  <ItemGroup>
    <None Include="$(MSBuildProjectDirectory)\Templates\**\*" Exclude="$(MSBuildProjectDirectory)\Templates\**\**\bin\**;$(MSBuildProjectDirectory)\Templates\**\**\obj\**;$(MSBuildProjectDirectory)\Templates\**\**\.vs\**;$(MSBuildProjectDirectory)\Templates\**\.template.config\**\*.md" Pack="true" PackagePath="" />
    <!-- NuGet package metadata from Properties/NugetMetadata is packed as package content. PackageReleaseNotes.txt is consumed for PackageReleaseNotes and is not packed as a loose file. -->
    <None Include="$(MSBuildProjectDirectory)\Properties\NugetMetadata\**\*" Pack="true" PackagePath="" Exclude="$(MSBuildProjectDirectory)\Properties\NugetMetadata\License.txt;$(MSBuildProjectDirectory)\Properties\NugetMetadata\PackageReleaseNotes.txt" />
    <!-- License.txt is generated only for Custom; the wildcard excludes it so the explicit PackageLicenseFile item controls packing. -->
    <!--#if (ProjectLicense == "Custom") -->
    <None Include="$(MSBuildProjectDirectory)\Properties\NugetMetadata\License.txt" Pack="true" PackagePath="" />
    <!--#endif -->
  </ItemGroup>

  <!-- Standard licenses use PackageLicenseExpression and create no License.txt. -->
  <!-- Custom: pack License.txt as PackageLicenseFile. PackagePath empty: nupkg root / docs/, not Properties/. -->
  <PropertyGroup>
    <PackageOutputPath Condition=" '$(PackageOutputPath)' == '' ">$(MSBuildProjectDirectory)\bin\Pack</PackageOutputPath>
  </PropertyGroup>

  <!-- Keep Git configuration on disk without showing it as a project item -->
  <ItemGroup>
    <None Remove=".gitignore" />
  </ItemGroup>
<!--#if (PlaceSolution == "BesideCsproj") -->
  <ItemGroup>
    <None Remove="__SourceName__.slnx;Readme.md" />
  </ItemGroup>
<!--#endif -->

  <!--#if (DirectoryMsBuildFiles) -->
  <!-- Auto-imported from this directory. Link is Solution Explorer only (under Properties\). -->
  <!-- Do not move the files into Properties/ on disk: MSBuild finds Directory.Build.* by folder. -->
  <ItemGroup>
    <None Remove="Directory.Build.props;Directory.Build.targets" />
    <None Include="Directory.Build.props" Link="Properties\Directory.Build.props" />
    <None Include="Directory.Build.targets" Link="Properties\Directory.Build.targets" />
  </ItemGroup>
  <!--#endif -->
  <!--#if (DotNetToolManifest) -->
  <!-- Disk path stays .config/: that is where `dotnet tool` looks. Link is Solution Explorer only. -->
  <ItemGroup>
    <None Remove=".config\dotnet-tools.json" />
    <None Include=".config\dotnet-tools.json" Link="Properties\dotnet-tools.json" />
  </ItemGroup>
  <!--#endif -->
<!--#if ((DirectoryMsBuildFiles) && (PlaceSolution == "BesideCsproj")) -->
  <ItemGroup>
    <None Remove="Directory.Solution.props;Directory.Solution.targets" />
    <None Include="Directory.Solution.props" Link="Properties\Directory.Solution.props" />
    <None Include="Directory.Solution.targets" Link="Properties\Directory.Solution.targets" />
  </ItemGroup>
<!--#endif -->

  <!-- Source Link git state as properties (SDK 8+). Target hooks GenerateAssemblyInfo. -->
  <Import Project="Properties/Build/SourceControlState.targets" />
  <!--#if (NerdbankGitVersioning == "Repo") -->
  <Import Project="Properties/Build/NerdbankRepositoryVersion.targets" />
  <!--#endif -->
</Project>
