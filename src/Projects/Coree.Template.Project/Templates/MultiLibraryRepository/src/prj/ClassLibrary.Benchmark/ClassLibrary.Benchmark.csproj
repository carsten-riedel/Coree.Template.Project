<Project Sdk="Microsoft.NET.Sdk">

  <!-- General build settings: run benchmarks on the highest selected target framework -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>__TargetFramework__</TargetFramework>
  </PropertyGroup>

  <!-- C# language features and debugging configuration -->
  <PropertyGroup>
    <!--#if (CSharpProjectOptions == "DisableImplicitUsings") -->
    <ImplicitUsings>disable</ImplicitUsings>
    <!--#else -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!--#endif -->
    <!--#if (CSharpProjectOptions == "Nullable") -->
    <Nullable>enable</Nullable>
    <!--#else -->
    <Nullable>disable</Nullable>
    <!--#endif -->
    <!--#if (CSharpProjectOptions == "DebugEmbedded") -->
    <DebugType>embedded</DebugType>
    <!--#else -->
    <DebugType>none</DebugType>
    <!--#endif -->
    <!--#if (CSharpProjectOptions == "LangLatest") -->
    <LangVersion>latest</LangVersion>
    <!--#else -->
    <LangVersion>default</LangVersion>
    <!--#endif -->
  </PropertyGroup>

  <!-- Packaging and publish configuration -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <IsTestProject>false</IsTestProject>
    <PackAsTool>false</PackAsTool>
  </PropertyGroup>

  <!-- Keep Git configuration on disk without showing it as a project item -->
  <ItemGroup>
    <None Remove=".gitignore" />
  </ItemGroup>

  <!-- Benchmark tooling -->
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <!-- Library under measurement -->
  <ItemGroup>
    <ProjectReference Include="..\ClassLibrary\ClassLibrary.csproj" />
  </ItemGroup>

</Project>
