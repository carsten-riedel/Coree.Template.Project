<Project>
	
	<Target Name="ResolveSourceControlState" DependsOnTargets="InitializeSourceControlInformation" BeforeTargets="GenerateAssemblyInfo;GenerateNuspec">

		<!--
			Resolve the primary source-control root exposed by the .NET SDK.

			Requires .NET SDK 8.0+ for built-in Source Link/Git integration.
			Nested roots (for example Git submodules) and roots without
			source-control metadata are excluded.
		-->
		<ItemGroup>
			<_PrimarySourceControlRoot Include="@(SourceRoot)" Condition="'%(SourceRoot.SourceControl)' != '' and '%(SourceRoot.ContainingRoot)' == ''" />
		</ItemGroup>

		<!--
			Materialize item metadata first.
			Item transforms must be evaluated before applying string property functions.
		-->
		<PropertyGroup>
			<_SourceControlTypeRaw>@(_PrimarySourceControlRoot->'%(SourceControl)')</_SourceControlTypeRaw>
			<_SourceControlRootRaw>@(_PrimarySourceControlRoot->'%(Identity)')</_SourceControlRootRaw>
			<_SourceControlRevisionIdRaw>@(_PrimarySourceControlRoot->'%(RevisionId)')</_SourceControlRevisionIdRaw>
			<_SourceControlRepositoryUrlRaw>@(_PrimarySourceControlRoot->'%(RepositoryUrl)')</_SourceControlRepositoryUrlRaw>
			<_SourceControlBranchNameRaw>@(_PrimarySourceControlRoot->'%(BranchName)')</_SourceControlBranchNameRaw>
		</PropertyGroup>

		<PropertyGroup>
			<!-- Source control available -->
			<HasSourceControl Condition="'@(_PrimarySourceControlRoot)' != ''">true</HasSourceControl>
			<HasSourceControl Condition="'$(HasSourceControl)' == ''">false</HasSourceControl>

			<!-- Provider: git, tfvc, ... -->
			<SourceControlType Condition="'$(HasSourceControl)' == 'true'">$(_SourceControlTypeRaw.Trim().ToLowerInvariant())</SourceControlType>

			<!-- Physical root -->
			<SourceControlRoot Condition="'$(HasSourceControl)' == 'true'">$(_SourceControlRootRaw.Trim())</SourceControlRoot>

			<!-- Revision -->
			<SourceControlRevisionId Condition="'$(SourceRevisionId)' != ''">$(SourceRevisionId.Trim())</SourceControlRevisionId>
			<SourceControlRevisionId Condition="'$(SourceControlRevisionId)' == '' and '$(HasSourceControl)' == 'true'">$(_SourceControlRevisionIdRaw.Trim())</SourceControlRevisionId>
			<HasSourceRevision Condition="'$(SourceControlRevisionId)' != ''">true</HasSourceRevision>
			<HasSourceRevision Condition="'$(HasSourceRevision)' == ''">false</HasSourceRevision>

			<!-- Repository URL, when supplied by the provider -->
			<SourceControlRepositoryUrl Condition="'$(HasSourceControl)' == 'true'">$(_SourceControlRepositoryUrlRaw.Trim())</SourceControlRepositoryUrl>

			<!-- Branch -->
			<SourceControlBranchName Condition="'$(SourceBranchName)' != ''">$(SourceBranchName.Trim())</SourceControlBranchName>
			<SourceControlBranchName Condition="'$(SourceControlBranchName)' == '' and '$(HasSourceControl)' == 'true'">$(_SourceControlBranchNameRaw.Trim())</SourceControlBranchName>
			<HasSourceBranch Condition="'$(SourceControlBranchName)' != ''">true</HasSourceBranch>
			<HasSourceBranch Condition="'$(HasSourceBranch)' == ''">false</HasSourceBranch>

			<!-- Convenience flag -->
			<HasGitSourceControl Condition="'$(SourceControlType)' == 'git'">true</HasGitSourceControl>
			<HasGitSourceControl Condition="'$(HasGitSourceControl)' == ''">false</HasGitSourceControl>
		</PropertyGroup>

	</Target>
</Project>