<Project Sdk="Microsoft.NET.Sdk">

  <!-- Branding information -->
  <PropertyGroup>
    <Branding>Carsten Riedel</Branding>
  </PropertyGroup>

    <!-- Company and copyright information -->
  <PropertyGroup>
    <Copyright>Copyright (c) 2026 $(Branding)</Copyright>
    <Company></Company>
  </PropertyGroup>

    <!-- C# language features and debugging configuration -->
  <PropertyGroup>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DebugType>embedded</DebugType>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>

  <!-- NuGet Package configuration -->

  <!-- Package metadata-->
  <!-- https://learn.microsoft.com/en-us/nuget/create-packages/package-authoring-best-practices -->

  <PropertyGroup>
    <Authors>Carsten Riedel</Authors>
    <Owners>Carsten Riedel</Owners>
    <PackageId>Coree.Template.Project</PackageId>
    <PackageTags>Project;Templates;.NET;ClassLibrary;Library;Analyzer;SourceGenerator;Roslyn;Console;Repository;Multi-project;NuGet;Coree;MSBuild;WPF</PackageTags>
    <PackageProjectUrl>https://github.com/carsten-riedel/Coree.Template.Project</PackageProjectUrl>
    <RepositoryUrl>https://github.com/carsten-riedel/Coree.Template.Project</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>
      <![CDATA[
          Templates for Visual Studio and the dotnet CLI: MSBuild tasks, class libraries, multi-library, multi-analyzer, multi-source-generator, multi-msbuild, and multi-console repositories, .NET tools, PowerShell cmdlets, WinForms, WPF, and a project template.
	    ]]>
    </Description>

    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>License.txt</PackageLicenseFile>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageReleaseNotes>$([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)\Properties\NugetAssets\ReleaseNotes.txt"))</PackageReleaseNotes>
  </PropertyGroup>

  <!-- Versioning: Nerdbank (Properties/version.json). Same Project layout as the multi templates. -->
  <PropertyGroup>
    <GitVersionBaseDirectory>$(MSBuildProjectDirectory)\Properties</GitVersionBaseDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.10.94">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Package specs -->
  <ItemGroup>
  <!-- NuGet template layout. Exclude bin/obj/.vs (VS can create those if an slnx is opened)
       and maintainer markdown under .template.config (not template content, not shipped). -->
    <None Include="$(MSBuildProjectDirectory)\Templates\**\*" Exclude="$(MSBuildProjectDirectory)\Templates\**\**\bin\**;$(MSBuildProjectDirectory)\Templates\**\**\obj\**;$(MSBuildProjectDirectory)\Templates\**\**\.vs\**;$(MSBuildProjectDirectory)\Templates\**\.template.config\**\*.md" Pack="true" PackagePath="" />
    <None Include="$(MSBuildProjectDirectory)\Properties\NugetAssets\**\*"  Pack="true" PackagePath="" />
  </ItemGroup>

  <PropertyGroup>
    <PackRelease>false</PackRelease>
    <PublishRelease>false</PublishRelease>
    <IncludeBuildOutput>False</IncludeBuildOutput>
    <IncludeSource>False</IncludeSource>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <EnableDefaultItems>False</EnableDefaultItems>
    <IsPackable>true</IsPackable>
    <IsShipping>false</IsShipping>
    <NoWarn>2008;NU5105</NoWarn>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <SuppressDependenciesWhenPacking>True</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <PackageType>Template</PackageType>
    <!-- Suppress creation of contentFiles directory -->
    <ContentTargetFolders>.\</ContentTargetFolders>
    <PackageOutputPath Condition=" '$(PackageOutputPath)' == '' ">$(MSBuildProjectDirectory)\bin\Package</PackageOutputPath>
  </PropertyGroup>

  <!-- dotnet pack -c Debug -->
  <!-- dotnet new install bin\Package\Coree.Template.Project.0.2.8863.32697-prerelease.nupkg -->
  <!-- dotnet new uninstall Coree.Template.Project -->
</Project>
