<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <!-- General build settings: defines the output type and target framework -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <!--
      Keep TargetFrameworks only. Do not add TargetFramework.
      `dotnet publish` with no -f uses the default TFM from
      Properties/Build/PublishDefaultFramework.targets. Override with
      `dotnet publish -f net8.0-windows` (or net10.0-windows, any selected TFM).
      Edit that file to change the default.
      To try a newer TFM (net11.0-windows, ...) before shipping it: append it to
      TargetFrameworks so build/test fail on incompatibilities, leave the
      targets file as-is until you want bare publish to follow.
    -->
    <TargetFrameworks>__TargetFrameworks__</TargetFrameworks>
  </PropertyGroup>

  <!-- C# language features and debugging configuration -->
  <PropertyGroup>
    <!--#if (CSharpProjectOptions == "DisableImplicitUsings") -->
    <ImplicitUsings>disable</ImplicitUsings>
    <!--#else -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!--#endif -->
    <!--#if (CSharpProjectOptions == "Nullable") -->
    <Nullable>enable</Nullable>
    <!--#else -->
    <Nullable>disable</Nullable>
    <!--#endif -->
    <!--#if (CSharpProjectOptions == "DebugEmbedded") -->
    <DebugType>embedded</DebugType>
    <!--#else -->
    <DebugType>none</DebugType>
    <!--#endif -->
    <!--#if (CSharpProjectOptions == "LangLatest") -->
    <LangVersion>latest</LangVersion>
    <!--#else -->
    <LangVersion>default</LangVersion>
    <!--#endif -->
  </PropertyGroup>

  <!--#if (UseProjectEditorGlobalConfig) -->
  <!-- GlobalAnalyzerConfigFiles is what Roslyn reads. Visible=false so VS does not show that item twice. -->
  <!-- None+Link is Solution Explorer only. Disk path stays next to the csproj: Properties/ would change analyzer scope. -->
  <!-- EnforceCodeStyleInBuild is required or IDE1006 stays IDE-only and `dotnet build` ignores the file. -->
  <!-- OptimizeImplicitlyTriggeredBuild=false: VS Test Explorer / F5 must not skip analyzers (dotnet test does not). -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <OptimizeImplicitlyTriggeredBuild>false</OptimizeImplicitlyTriggeredBuild>
  </PropertyGroup>
  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="$(MSBuildProjectDirectory)\.project.editor.globalconfig" Visible="false" />
    <None Remove=".project.editor.globalconfig" />
    <None Include=".project.editor.globalconfig" Link="Properties\.project.editor.globalconfig" />
  </ItemGroup>
  <!--#endif -->

  <!-- SDK CA rule set. Always written; omitted AnalysisMode switch means Recommended. -->
  <PropertyGroup>
    <AnalysisMode>__AnalysisMode__</AnalysisMode>
  </PropertyGroup>

  <!-- Packaging and publish configuration -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <PackAsTool>false</PackAsTool>
    <IsPublishable>true</IsPublishable>
    <PublishRelease>true</PublishRelease>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <!-- SDK defaults stay. CheckEol: true for exe, skipped for Library. InvariantGlobalization unset = cultures on. -->
  <PropertyGroup>
    <CheckEolTargetFramework>$(CheckEolTargetFramework)</CheckEolTargetFramework>
    <InvariantGlobalization>$(InvariantGlobalization)</InvariantGlobalization>
  </PropertyGroup>

  <!--#if (ProgramSample == "HostedDi") -->
  <!-- HostedDi application assets and configuration. -->
  <PropertyGroup>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\application.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Properties\appsettings.json;Resources\application.ico" />
    <Content Include="Properties\appsettings.json">
      <TargetPath>appsettings.json</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <EmbeddedResource Include="Resources\application.ico" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>
  <!--#endif -->

  <!--#if (UseNerdbankGitVersioning) -->
  <!-- Versioning: Nerdbank -->
  <!--#if (NerdbankGitVersioning == "Project") -->
  <PropertyGroup>
    <GitVersionBaseDirectory>$(MSBuildProjectDirectory)\Properties</GitVersionBaseDirectory>
  </PropertyGroup>
  <!--#endif -->
  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.10.94">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <!--#else -->
  <!-- Versioning -->
  <PropertyGroup>
    <VersionMajor>0</VersionMajor>
    <VersionMinor>1</VersionMinor>
    <VersionBuild>0</VersionBuild>
    <VersionRevision>0</VersionRevision>
    <VersionPrefix>$(VersionMajor).$(VersionMinor).$(VersionBuild).$(VersionRevision)</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == '' and '$(Configuration)' == 'Debug'">prerelease</VersionSuffix>
    <PackageVersion Condition="'$(VersionSuffix)' == ''">$(VersionPrefix)</PackageVersion>
    <PackageVersion Condition="'$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</PackageVersion>
    <InformationalVersion>$(PackageVersion)</InformationalVersion>
    <AssemblyVersion>$(VersionPrefix)</AssemblyVersion>
  </PropertyGroup>
  <!--#endif -->

  <!-- Assembly identity. -->
  <PropertyGroup>
    <Authors>MyAuthor</Authors>
    <!--#if (PackageCopyrightHolderIsOrganization == true) -->
    <!--#if (PackageCopyrightHolderIsSet) -->
    <Company>MyCopyrightHolder</Company>
    <!--#else -->
    <Company>MyAuthor</Company>
    <!--#endif -->
    <!--#else -->
    <Company></Company>
    <!--#endif -->
    <!--#if (PackageCopyrightHolderIsSet) -->
    <Copyright>Copyright © 1975 MyCopyrightHolder</Copyright>
    <!--#else -->
    <Copyright>Copyright © 1975 MyAuthor</Copyright>
    <!--#endif -->
    <Description><![CDATA[]]></Description>
  </PropertyGroup>

  <!-- Publish output. Recipes apply only while _IsPublishing. -->
	<PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
		<!-- Flat publish output -->
		<PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildProjectDirectory)\bin\Publish\</PublishDir>
		<PublishAot>false</PublishAot>
		<PublishTrimmed>false</PublishTrimmed>
	</PropertyGroup>

  <!-- Publish profile. Generate-time choices; MSBuild reads them only when publishing. RID is always win-x64. -->
	<PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<!--#if (Publish == FrameworkIncludedSingleCompressed) -->
		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<PublishReadyToRun>true</PublishReadyToRun>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<!--#endif -->
		<!--#if (Publish == FrameworkRequired) -->
		<SelfContained>false</SelfContained>
		<!--#endif -->
		<!--#if (Publish == FrameworkRequiredSingle) -->
		<SelfContained>false</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<!--#endif -->
		<!--#if (Publish == FrameworkIncluded) -->
		<SelfContained>true</SelfContained>
		<PublishSingleFile>false</PublishSingleFile>
		<IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
		<!--#endif -->
		<!--#if (Publish == FrameworkIncludedSingle) -->
		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<PublishReadyToRun>true</PublishReadyToRun>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<!--#endif -->
	</PropertyGroup>

  <!-- Keep Git configuration on disk without showing it as a project item -->
  <ItemGroup>
    <None Remove=".gitignore" />
  </ItemGroup>
<!--#if (PlaceSolution == "BesideCsproj") -->
  <ItemGroup>
    <None Remove="__SourceName__.slnx;Readme.md" />
  </ItemGroup>
<!--#endif -->

  <!--#if (DirectoryMsBuildFiles) -->
  <!-- Auto-imported from this directory. Link is Solution Explorer only (under Properties\). -->
  <!-- Do not move the files into Properties/ on disk: MSBuild finds Directory.Build.* by folder. -->
  <ItemGroup>
    <None Remove="Directory.Build.props;Directory.Build.targets" />
    <None Include="Directory.Build.props" Link="Properties\Directory.Build.props" />
    <None Include="Directory.Build.targets" Link="Properties\Directory.Build.targets" />
  </ItemGroup>
  <!--#endif -->
  <!--#if (DotNetToolManifest) -->
  <!-- Disk path stays .config/: that is where `dotnet tool` looks. Link is Solution Explorer only. -->
  <ItemGroup>
    <None Remove=".config\dotnet-tools.json" />
    <None Include=".config\dotnet-tools.json" Link="Properties\dotnet-tools.json" />
  </ItemGroup>
  <!--#endif -->
<!--#if ((DirectoryMsBuildFiles) && (PlaceSolution == "BesideCsproj")) -->
  <ItemGroup>
    <None Remove="Directory.Solution.props;Directory.Solution.targets" />
    <None Include="Directory.Solution.props" Link="Properties\Directory.Solution.props" />
    <None Include="Directory.Solution.targets" Link="Properties\Directory.Solution.targets" />
  </ItemGroup>
<!--#endif -->

  <!-- Source Link git state as properties (SDK 8+). Target hooks GenerateAssemblyInfo. -->
  <Import Project="Properties/Build/SourceControlState.targets" />
  <!--#if (NerdbankGitVersioning == "Repo") -->
  <Import Project="Properties/Build/NerdbankRepositoryVersion.targets" />
  <!--#endif -->
  <!--
    Must stay last. This import is Sdk.targets plus the outer Publish dispatch.
    The SDK reads properties and items while it loads (EnforceCodeStyleInBuild,
    GlobalAnalyzerConfigFiles, AnalysisMode, publish). Anything after this line is after the
    SDK and is ignored for that. Project Sdk="..." would append Sdk.targets
    after this file and overwrite the Publish override.
  -->
  <Import Project="Properties/Build/ImportSdkTargets.targets" />

</Project>
