{
  "$schema": "http://json.schemastore.org/template",
  "author": "Carsten Riedel",
  // Opts Visual Studio into category display in the New Project dialog
  "classifications": [ "Common", "dotnet", "Windows", "WPF", "Test", "Solution", "Repository", "Multi-project", "Coree" ],
  "identity": "CoreeTemplatesProjectMultiWpfAppRepository",
  // Displayname is used in the New Project dialog and in the dotnet new list output.
  "name": ".NET multi-wpf repository",
  "description": "Repository of one or more independently publishable C# WPF apps. Tests and Coverlet coverage included; optional ReportGenerator, BenchmarkDotNet, Nerdbank.GitVersioning, and documentation template.",
  "shortName": "multiwpfrepo-coree",
  // Host metadata: libraries this template uses that the author does not own.
  // After create, CLI prints this URL. The markdown lives next to this file;
  // .template.config *.md is not packed and is not generated into the repo.
  "thirdPartyNotices": "https://github.com/carsten-riedel/Coree.Template.Project/blob/main/src/prj/Coree.Template.Project/Templates/MultiWpfAppRepository/.template.config/THIRD-PARTY-NOTICES.md",
  "tags": {
    "language": "C#",
    "type": "solution",
    // Opts Visual Studio into its solution-template UI instead of the project-template UI.
    "editorTreatAs": "solution"
  },
  "defaultName": "Organization.Domain.WpfApp", // Organization.Domain.Functionality
  "sourceName": "__SourceName__", // Folders, csproj, namespace. Replaced by --name.
  // Visual Studio creates the outer solution directory; true would add another name directory.
  "preferNameDirectory": false,
  // Active SDK only (`dotnet --version`). [8.0,) is 8 and later, any feature band - not 8.0.100.
  // `8.*` would hide the template on SDK 9/10. Unmet: installed but not listed / not instantiated.
  "constraints": {
    "sdk": {
      "type": "sdk-version",
      "args": "[8.0,)"
    }
  },
  "symbols": {
    // HostIdentifier is bound by the template host (dotnetcli, vs, …).
    // Default "dotnetcli" so CLI-only dry runs still evaluate CLI rename rules.
    "HostIdentifier": {
      "type": "bind",
      "binding": "host:HostIdentifier",
      "defaultValue": "dotnetcli"
    },
    // One multi-choice instead of N root bools (VS stays one group, like TFMs).
    // CLI default is empty: later apps omit both switches, no root collisions.
    // Visual Studio does not allow an empty multi-choice (at least one value).
    // None is the explicit empty set; it is first so a host that snaps to the
    // first choice still writes no root files. None also overrides other
    // selections if the IDE leaves leftover checks on, including InitAllRepoItems.
    // Visual Studio selects the real items via ide.host.json defaultValue.
    // CLI first-create set is InitAllRepoItems (bool, hidden in VS).
    // In conditions, == means "this value is among the selected choices".
    "InitRepoItems": {
      "type": "parameter",
      "datatype": "choice",
      "allowMultipleValues": true,
      "enableQuotelessLiterals": true,
      "isRequired": false,
      "defaultValue": "",
      "description": "Pick individual first-create files. Omit on later apps in the same folder. For the full first-create set on CLI, use --InitAllRepoItems. src/global.json is optional and off by default (not in that set). Visual Studio cannot leave this empty: choose None.",
      "displayName": "Repository root items",
      "choices": [
        {
          "choice": "None",
          "description": "Do not add first-create files. Use this in Visual Studio when adding another WPF app to an existing repository.",
          "displayName": "None"
        },
        {
          "choice": "Readme",
          "description": "Add README.md at the top of the repository.",
          "displayName": "README.md"
        },
        {
          "choice": "AIReleaseCheckpoint",
          "description": "Add TEMPLATE-AI-RELEASE-CHECKPOINT.md. Complete it from the product (yourself or with an assistant) before the first publish, then delete it.",
          "displayName": "AI-supported release checkpoint"
        },
        {
          "choice": "GitAttributes",
          "description": "Add .gitattributes at the top of the repository.",
          "displayName": ".gitattributes"
        },
        {
          "choice": "GitIgnore",
          "description": "Add .gitignore at the top of the repository. Nested src/prj and src/sln ignores stay. First create only.",
          "displayName": ".gitignore"
        },
        {
          "choice": "RepoLicense",
          "description": "Copy the selected project license into a LICENSE file at the repository root (GitHub convention). First repository create only.",
          "displayName": "LICENSE file at repository root"
        },
        {
          "choice": "SrcGlobalJson",
          "description": "Add src/global.json pinning the .NET SDK to this create's highest selected target framework (8.0.0, 9.0.0, or 10.0.0; rollForward latestFeature). Optional; off by default; not part of --InitAllRepoItems. First create only. Walk-up from folders under src/. Does not pin commands run at the repository root.",
          "displayName": "src/global.json"
        }
      ]
    },
    // CLI-only first-create set: README, checkpoint, .gitattributes, .gitignore,
    // LICENSE. Same five files as the Visual Studio ide.host default. Hidden in VS.
    // ide.host default. Hidden in VS. src/global.json is not in this set
    // (SrcGlobalJson, default off).
    // None on InitRepoItems still writes nothing. Root version.json is not
    // in this set; it is --NerdbankGitVersioning Repo plus first-create Init
    // (WriteRepoVersionJson).
    "InitAllRepoItems": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "description": "Add all repository-root files (README.md, AI-supported release checkpoint, .gitattributes, .gitignore, LICENSE). Same set as a Visual Studio first create. Does not add version.json or src/global.json. First create only.",
      "displayName": "All repository root items"
    },
    // Where the TEMPLATE .slnx is written.
    // SlnFolder (default): src/sln/__SourceName__/__SourceName__.slnx plus
    // handbook Readme.md - one folder per app so `dotnet` there does not
    // see sibling .slnx files.
    // BesideCsproj: src/prj/__SourceName__/ next to the packable csproj
    // (slnx + handbook; tests and benchmark stay sibling projects under
    // src/prj/). Does not create src/sln/{name}/.
    // RepoRoot: repository root. CLI renames to __SourceName__.slnx; Visual
    // Studio keeps __SourceName__.generated.slnx so it does not overwrite the
    // IDE's conventional {Name}.slnx. src/sln/{name}/Readme.md is still notes.
    // RepoRoot stacks every app's .slnx in one directory; CLI/CI must pass
    // a solution path if more than one exists.
    "PlaceSolution": {
      "type": "parameter",
      "datatype": "choice",
      "isRequired": false,
      "defaultValue": "SlnFolder",
      "enableQuotelessLiterals": true,
      "description": "Where this app's .slnx is written. Default src/sln/{name}/ (handbook beside that file). BesideCsproj writes the .slnx and handbook next to the WPF app csproj and does not create src/sln/{name}/. Do not collect several .slnx files in one directory: `dotnet` then requires an explicit path (MSB1011).",
      "displayName": "Solution file location",
      "choices": [
        {
          "choice": "SlnFolder",
          "description": "Default. One .slnx per app folder so `dotnet` does not ask which file to use.",
          "displayName": "src/sln/{name}/"
        },
        {
          "choice": "RepoRoot",
          "description": "Repository root. Later apps share that directory, so `dotnet` needs the .slnx path (MSB1011).",
          "displayName": "Repository root"
        },
        {
          "choice": "BesideCsproj",
          "description": "Next to this app's csproj (slnx and handbook). Does not create src/sln/{name}/. Tests and benchmark stay sibling projects under src/prj/.",
          "displayName": "src/prj/{name}/"
        }
      ]
    },
    // True for dotnet new / preview CLI. Used so only CLI renames
    // .generated.slnx → __SourceName__.slnx at repo root when PlaceSolution is
    // RepoRoot. Visual Studio keeps the .generated name and therefore does
    // not overwrite its own root .slnx.
    "IsCliHost": {
      "type": "computed",
      "value": "(HostIdentifier == \"dotnetcli\" || HostIdentifier == \"dotnetcli-preview\")"
    },
    // User-selectable Windows TFMs. Multiple values are supported for
    // multi-targeting. App, tests, and benchmark all use these values
    // (tests: TargetFrameworks; benchmark: highest as TargetFramework).
    "TargetFrameworks": {
      "type": "parameter",
      "description": "Windows target frameworks for the app, tests, and benchmark (netN.0-windows).",
      "datatype": "choice",
      "allowMultipleValues": true,
      "enableQuotelessLiterals": true,
      "choices": [
        {
          "choice": "net8.0-windows",
          "description": "Target net8.0-windows",
          "displayName": ".NET 8.0 Windows"
        },
        {
          "choice": "net9.0-windows",
          "description": "Target net9.0-windows",
          "displayName": ".NET 9.0 Windows"
        },
        {
          "choice": "net10.0-windows",
          "description": "Target net10.0-windows",
          "displayName": ".NET 10.0 Windows"
        }
      ],
      "defaultValue": "net8.0-windows|net10.0-windows"
    },
    // Publish-time only. Same named recipes as wpfapp-coree.
    "Publish": {
      "type": "parameter",
      "description": "Publish recipe written into the WPF app csproj. Applies when _IsPublishing is true.",
      "datatype": "choice",
      "allowMultipleValues": false,
      "enableQuotelessLiterals": true,
      "displayName": "Publish profile",
      "choices": [
        {
          "choice": "FrameworkIncludedSingleCompressed",
          "description": "Self-contained single-file with ReadyToRun and compression. Default.",
          "displayName": "Framework-included, single-file, compressed, ReadyToRun (default)"
        },
        {
          "choice": "FrameworkRequired",
          "description": "Framework-dependent. For an installer that has the runtime.",
          "displayName": "Framework-required (installer)"
        },
        {
          "choice": "FrameworkRequiredSingle",
          "description": "Framework-dependent single-file. Smallest copy.",
          "displayName": "Framework-required, single-file (copy smallest)"
        },
        {
          "choice": "FrameworkIncluded",
          "description": "Self-contained, not single-file. For an installer.",
          "displayName": "Framework-included (installer)"
        },
        {
          "choice": "FrameworkIncludedSingle",
          "description": "Self-contained single-file with ReadyToRun. Large copy.",
          "displayName": "Framework-included, single-file, ReadyToRun (copy large)"
        }
      ],
      "defaultValue": "FrameworkIncludedSingleCompressed"
    },
    // One multi-choice for C# / debug in the WPF app, tests, and
    // benchmark (VS combobox, like TFMs and InitRepoItems). Checked =
    // current product default. Unchecked = the other explicit value.
    // Properties are always written. No XML documentation file switch.
    // No None: CLI/VS default is the four language/debug values; Visual
    // Studio keeps at least one checked. Omit the switch on CLI.
    "CSharpProjectOptions": {
      "type": "parameter",
      "datatype": "choice",
      "allowMultipleValues": true,
      "enableQuotelessLiterals": true,
      "isRequired": false,
      "defaultValue": "DisableImplicitUsings|Nullable|LangLatest|DebugEmbedded",
      "description": "C# and debug settings for the WPF app, tests, and benchmark. Uncheck an item to write the alternative value.",
      "displayName": "C# project options",
      "choices": [
        {
          "choice": "DisableImplicitUsings",
          "description": "Do not add global implicit usings. Uncheck to enable them.",
          "displayName": "Disable implicit usings"
        },
        {
          "choice": "Nullable",
          "description": "Enable nullable reference types. Uncheck to disable them.",
          "displayName": "Nullable"
        },
        {
          "choice": "LangLatest",
          "description": "Use the newest C# the installed SDK understands. Uncheck for the TFM default.",
          "displayName": "Latest language version"
        },
        {
          "choice": "DebugEmbedded",
          "description": "Embed portable PDBs in the assembly. Uncheck for no debug symbols.",
          "displayName": "Embedded debug symbols"
        }
      ]
    },
    // Exclusive seeds under TemplateAssets/ProgramSamples/{choice}/
    // App|Tests|Benchmark/. Extra sources copy each folder onto the stub
    // project path (no per-file rename). MinimalClassic is the VS WPF
    // skeleton (App.xaml + MainWindow). MahAppsMvvm is a cohesive hosted
    // MVVM app with Material Design, localization, and SQLite; its features
    // are not exposed as separate switches.
    "ProgramSample": {
      "type": "parameter",
      "datatype": "choice",
      "isRequired": false,
      "defaultValue": "MinimalClassic",
      "enableQuotelessLiterals": true,
      "description": "Which WPF sample to copy. MinimalClassic remains the default. MahAppsMvvm adds a cohesive hosted MVVM app with Material Design, localization, configuration, and SQLite. Matching tests and the optional benchmark are copied with the same choice.",
      "displayName": "Program sample",
      "choices": [
        {
          "choice": "MinimalClassic",
          "description": "Visual Studio WPF skeleton: App.xaml StartupUri and an empty MainWindow.",
          "displayName": "Minimal classic"
        },
        {
          "choice": "MahAppsMvvm",
          "description": "Hosted MVVM app with MahApps, Material Design, localization, configuration, and a SQLite demo.",
          "displayName": "MahApps + Material Design MVVM"
        }
      ]
    },
    // Optional additional project. The normal app publish remains the source
    // for the per-user MSI; no installer is generated by default.
    "AdditionalInstaller": {
      "type": "parameter",
      "datatype": "choice",
      "allowMultipleValues": false,
      "isRequired": false,
      "defaultValue": "None",
      "enableQuotelessLiterals": true,
      "description": "Optionally add a Windows-only separate WiX user installer that runs after the normal app publish and writes the MSI to bin/Setup. Visual Studio requires the WiX Toolset HeatWave extension installed; the dotnet CLI uses the WiX SDK package.",
      "displayName": "Additional WiX user installer (publish step)",
      "choices": [
        {
          "choice": "None",
          "description": "Do not add an installer project.",
          "displayName": "None"
        },
        {
          "choice": "WixUserInstaller",
          "description": "Add a Windows per-user WiX installer as a separate project. It packages the normal app publish output into bin/Setup. Visual Studio requires the WiX Toolset HeatWave extension installed.",
          "displayName": "Additional WiX user installer (publish step)"
        }
      ]
    },
    "InstallerUpgradeCode": {
      "type": "generated",
      "generator": "guid",
      "replaces": "00000000-0000-0000-0000-000000000002"
    },
    // Converts the selected framework values to the semicolon-separated MSBuild list.
    "TargetFrameworksValue": {
      "type": "generated",
      "generator": "join",
      "replaces": "__TargetFrameworks__",
      "parameters": {
        "symbols": [
          {
            "type": "ref",
            "value": "TargetFrameworks"
          }
        ],
        "separator": ";",
        "removeEmptyValues": true
      }
    },
    // Resolves the highest selected framework to one value for single-framework paths and filenames.
    "TargetFrameworkValue": {
      "type": "generated",
      "generator": "switch",
      "replaces": "__TargetFramework__",
      "parameters": {
        "datatype": "string",
        "cases": [
          {
            "condition": "(TargetFrameworks == \"net10.0-windows\")",
            "value": "net10.0-windows"
          },
          {
            "condition": "(TargetFrameworks == \"net9.0-windows\")",
            "value": "net9.0-windows"
          },
          {
            "condition": "(TargetFrameworks == \"net8.0-windows\")",
            "value": "net8.0-windows"
          }
        ]
      }
    },
    // Same highest-first order as TargetFrameworkValue. Pins src/global.json
    // sdk.version (8.0.0 / 9.0.0 / 10.0.0). Placeholder must not appear elsewhere.
    "SdkPinVersion": {
      "type": "generated",
      "generator": "switch",
      "replaces": "0.0.0-sdk-pin",
      "parameters": {
        "datatype": "string",
        "cases": [
          {
            "condition": "(TargetFrameworks == \"net10.0-windows\")",
            "value": "10.0.0"
          },
          {
            "condition": "(TargetFrameworks == \"net9.0-windows\")",
            "value": "9.0.0"
          },
          {
            "condition": "(TargetFrameworks == \"net8.0-windows\")",
            "value": "8.0.0"
          }
        ]
      }
    },
    // Author / copyright placeholders (assembly identity).
    "Author": {
      "type": "parameter",
      "dataType": "string",
      "replaces": "MyAuthor",
      "description": "The author of the project. Writes Authors and, when empty, the copyright holder fallback.",
      "displayName": "Author",
      "isRequired": "true"
    },
    "PackageCopyrightHolder": {
      "type": "parameter",
      "dataType": "string",
      "defaultValue": "",
      "replaces": "MyCopyrightHolder",
      "description": "Copyright holder for the assembly, license, and package. Defaults to the author when empty.",
      "displayName": "Copyright holder"
    },
    "PackageCopyrightHolderIsSet": {
      "type": "computed",
      "value": "(PackageCopyrightHolder != \"\")"
    },
    "PackageCopyrightHolderIsOrganization": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "description": "Set when the copyright holder is an organization. Controls the Company property.",
      "displayName": "Copyright holder is an organization"
    },
    // Date generators replace fixed template placeholders in project metadata and package assets.
    "copyrightYear": {
      "type": "generated",
      "generator": "now",
      "replaces": "1975",
      "parameters": {
        "format": "yyyy"
      }
    },
    "datenowsort": {
      "type": "generated",
      "generator": "now",
      "replaces": "1975-01-01",
      "parameters": {
        "format": "yyyy-MM-dd"
      }
    },
    // Single choice (dropdown). Default Project = version.json under
    // Properties/. Combo-safe: later apps do not collide. Off keeps
    // the VersionPrefix group. Repo uses one root version.json (first
    // create only via WriteRepoVersionJson), not the choice by itself.
    "NerdbankGitVersioning": {
      "type": "parameter",
      "datatype": "choice",
      "isRequired": false,
      "defaultValue": "Project",
      "enableQuotelessLiterals": true,
      "description": "Nerdbank.GitVersioning. Default is this app (version.json under Properties/). This repository uses one version.json at the repo root (first create only). Off keeps VersionPrefix in the WPF app project (no extra package).",
      "displayName": "Nerdbank.GitVersioning",
      "choices": [
        {
          "choice": "Project",
          "description": "Add Nerdbank.GitVersioning with version.json in this app's Properties folder. Default. Every create; paths do not collide.",
          "displayName": "This app (Properties/version.json)"
        },
        {
          "choice": "Repo",
          "description": "Add Nerdbank.GitVersioning using a repository-root version.json. The file is written only on a first create (--InitAllRepoItems or Visual Studio root items). Later apps pass --NerdbankGitVersioning Repo without Init*.",
          "displayName": "This repository (root version.json)"
        },
        {
          "choice": "Off",
          "description": "VersionMajor / VersionPrefix / PackageVersion in the WPF app csproj. No Nerdbank.GitVersioning package.",
          "displayName": "Off (VersionPrefix in the WPF app project)"
        }
      ]
    },
    "UseNerdbankGitVersioning": {
      "type": "computed",
      "value": "(NerdbankGitVersioning == \"Project\" || NerdbankGitVersioning == \"Repo\")"
    },
    "WriteRepoVersionJson": {
      "type": "computed",
      "value": "(NerdbankGitVersioning == \"Repo\") && (InitRepoItems != \"None\") && (InitAllRepoItems || (InitRepoItems == \"Readme\") || (InitRepoItems == \"AIReleaseCheckpoint\") || (InitRepoItems == \"GitAttributes\") || (InitRepoItems == \"GitIgnore\") || (InitRepoItems == \"RepoLicense\") || (InitRepoItems == \"SrcGlobalJson\"))"
    },
    "WriteRepoLicense": {
      "type": "computed",
      "value": "(InitRepoItems != \"None\") && (InitAllRepoItems || (InitRepoItems == \"RepoLicense\"))"
    },
    "WriteSrcGlobalJson": {
      "type": "computed",
      "value": "(InitRepoItems != \"None\") && (InitRepoItems == \"SrcGlobalJson\")"
    },
    // Multi-choice. Default empty/None. Same DocShell.html seed.
    // Repository is repo-root docs/ and collides on a later app (Exit 73).
    // Not part of InitAllRepoItems. No package-docs destination: these apps
    // are publish-only (no NuGet tool nupkg). Do not vendor the 25-file site
    // here: bootstrap follows DocShell.html and takes the versions it pins then.
    "DocumentationTemplate": {
      "type": "parameter",
      "datatype": "choice",
      "allowMultipleValues": true,
      "enableQuotelessLiterals": true,
      "isRequired": false,
      "defaultValue": "",
      "description": "Optional offline documentation template (DocShell.html). Repository writes it under repo-root docs/ (first create only). None writes nothing. Bootstrap and mini docs are a checkpoint task, not generate-time.",
      "displayName": "Documentation template",
      "choices": [
        {
          "choice": "None",
          "description": "Do not add a documentation template.",
          "displayName": "None"
        },
        {
          "choice": "Repository",
          "description": "Add DocShell.html under docs/ at the repository root. First create only; a later app in the same folder that selects this again is Exit 73.",
          "displayName": "Repository docs (docs/)"
        }
      ]
    },
    "WriteRepoDocTemplate": {
      "type": "computed",
      "value": "(DocumentationTemplate == \"Repository\") && (DocumentationTemplate != \"None\")"
    },
    // Project license. Single choice. MIT first and default.
    // Repo root LICENSE is InitRepoItems RepoLicense or InitAllRepoItems.
    // These apps are publish-only (no NuGet tool nupkg / PackageLicenseExpression).
    "ProjectLicense": {
      "type": "parameter",
      "datatype": "choice",
      "isRequired": false,
      "defaultValue": "MIT",
      "description": "License for the app. Default MIT. The LICENSE file at repository root copies this license when that first-create item is selected.",
      "displayName": "Project license",
      "choices": [
        {
          "choice": "MIT",
          "description": "MIT. Used for the repository-root LICENSE when that file is written.",
          "displayName": "MIT"
        },
        {
          "choice": "BSD3Clause",
          "description": "BSD 3-Clause. Used for the repository-root LICENSE when that file is written.",
          "displayName": "BSD 3-Clause"
        },
        {
          "choice": "Apache2",
          "description": "Apache 2.0. Used for the repository-root LICENSE when that file is written.",
          "displayName": "Apache 2.0"
        },
        {
          "choice": "Custom",
          "description": "Copyright only (all rights reserved until you add terms). Used for the repository-root LICENSE when that file is written.",
          "displayName": "Custom"
        }
      ]
    },
    // WPF-app .project.editor.globalconfig via GlobalAnalyzerConfigFiles.
    // Strict (default) is the VS style dump plus naming/nullable as error.
    // No CS1591 / IDE0005 (XML docs off; tool nupkg has no IntelliSense
    // contract; IDE0005 needs GenerateDocumentationFile). Default is the same dump
    // with suggestions only. Off writes nothing. Generated disk name is always
    // .project.editor.globalconfig; seeds live under TemplateAssets/CodeStyle/
    // as .project.editor.globalconfig.{choice}. Wire it before
    // ImportSdkTargets; EnforceCodeStyleInBuild is required or IDE naming
    // stays IDE-only. OptimizeImplicitlyTriggeredBuild=false so VS Test
    // Explorer / F5 do not skip those analyzers (`dotnet test` does not).
    "ProjectEditorGlobalConfig": {
      "type": "parameter",
      "datatype": "choice",
      "isRequired": false,
      "defaultValue": "Strict",
      "enableQuotelessLiterals": true,
      "description": "Editor and analyzer rules beside the WPF app project, applied in the IDE and on build. Default is Strict: naming and nullable fail the build. Default (style suggestions) is the same dump without those errors. Off writes no file. Test and benchmark projects are not affected.",
      "displayName": "Code style rules for WPF app project",
      "choices": [
        {
          "choice": "Strict",
          "description": "Same style dump as Default, plus naming and nullable errors. Default. Needs nullable on in C# project options. No XML-doc or unused-using build errors.",
          "displayName": "Strict (public release errors)"
        },
        {
          "choice": "Default",
          "description": "VS style dump as .project.editor.globalconfig. Naming and style stay suggestions. EnforceCodeStyleInBuild and OptimizeImplicitlyTriggeredBuild=false are still on.",
          "displayName": "Default (style suggestions)"
        },
        {
          "choice": "Off",
          "description": "Do not add .project.editor.globalconfig, EnforceCodeStyleInBuild, or OptimizeImplicitlyTriggeredBuild.",
          "displayName": "Off (no code style file)"
        }
      ]
    },
    "UseProjectEditorGlobalConfig": {
      "type": "computed",
      "value": "(ProjectEditorGlobalConfig != \"Off\")"
    },
    // SDK CA rule set (AnalysisMode). Not style/CS (that is
    // ProjectEditorGlobalConfig). Recommended
    // is the omit-the-switch default. Always written so the generated csproj
    // does not follow a later SDK Default shift. Tests and benchmark omit it.
    "AnalysisMode": {
      "type": "parameter",
      "datatype": "choice",
      "isRequired": false,
      "defaultValue": "Recommended",
      "enableQuotelessLiterals": true,
      "replaces": "__AnalysisMode__",
      "description": "SDK code-analysis mode for the WPF app (CA rules). Default Recommended. Minimum is fewer warnings. All is almost every CA rule as a warning. Test and benchmark projects are not affected.",
      "displayName": "Code analysis mode",
      "choices": [
        {
          "choice": "Recommended",
          "description": "Enable the SDK recommended CA rules as build warnings. Default.",
          "displayName": "Recommended"
        },
        {
          "choice": "Minimum",
          "description": "Fewer CA rules than Recommended; highly recommended warnings only.",
          "displayName": "Minimum"
        },
        {
          "choice": "All",
          "description": "Almost every CA rule as a build warning. Noisier on a new app.",
          "displayName": "All"
        }
      ]
    },
    // Test-project coverage. Single choice because ReportGenerator consumes
    // Coverlet output: Report-without-Coverlet is a dead combo. Default
    // Coverlet (combo-safe, coverage stats on dotnet test). ReportGenerator
    // is opt-in presentation. Computed CoverletMSBuild / ReportGenerator
    // keep the existing csproj and sln-readme #if names.
    "TestCoverage": {
      "type": "parameter",
      "datatype": "choice",
      "isRequired": false,
      "defaultValue": "Coverlet",
      "enableQuotelessLiterals": true,
      "description": "Test coverage on the test project. Default is Coverlet: dotnet test fails if the app is under 100% line/branch/method coverage. Lower Threshold in the test csproj if you want less. Coverlet and ReportGenerator also writes HTML/Markdown. None writes no extra test packages. The app is not affected.",
      "displayName": "Test coverage",
      "choices": [
        {
          "choice": "Coverlet",
          "description": "Add coverlet.msbuild and collect coverage on dotnet test. Default. Fails the test run below 100% line/branch/method on the app assembly. Lower Threshold in the test csproj to allow less. Raw Coverlet output only.",
          "displayName": "Coverlet only (100% gate)"
        },
        {
          "choice": "CoverletAndReport",
          "description": "Coverlet plus ReportGenerator HTML/Markdown from the Coverlet output, one folder per target framework. Same 100% coverage gate as Coverlet only.",
          "displayName": "Coverlet and ReportGenerator (100% gate)"
        },
        {
          "choice": "None",
          "description": "No Coverlet and no ReportGenerator. Tests still run.",
          "displayName": "None (no coverage)"
        }
      ]
    },
    "CoverletMSBuild": {
      "type": "computed",
      "value": "(TestCoverage != \"None\")"
    },
    "ReportGenerator": {
      "type": "computed",
      "value": "(TestCoverage == \"CoverletAndReport\")"
    },
    // Keeps BenchmarkDotNet isolated in an optional executable project.
    "BenchmarkProject": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "description": "Add an optional BenchmarkDotNet console project.",
      "displayName": "Add optional BenchmarkDotNet console project"
    },
    // Opt-in empty Directory.Build.props/.targets next to this app csproj
    // and Directory.Solution.props/.targets next to this app's .slnx
    // (src/sln/{name}/, repo root, or src/prj/{name}/ - follows PlaceSolution).
    // Combo-safe when the .slnx is not stacked in one shared directory.
    // Not Init. No Directory.Packages.props (CPM would not cover sibling tests).
    // Tests and benchmark are not in this switch. Default off.
    "DirectoryMsBuildFiles": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "description": "Add empty Directory.Build.props and Directory.Build.targets beside this WPF app project, and Directory.Solution.props and Directory.Solution.targets beside this app's .slnx (follows PlaceSolution). Landing files for extra MSBuild you do not want in the csproj. Test and benchmark projects are not affected. Default off.",
      "displayName": "Empty Directory.Build and Directory.Solution MSBuild files"
    },
    // Empty local tool manifest beside this app csproj. Default on.
    // Combo-safe: path includes the app name. Not Init. No tools pinned
    // and no tool restore on build. Tests and benchmark are not in this switch.
    "DotNetToolManifest": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "true",
      "description": "Add an empty .config/dotnet-tools.json beside this WPF app project (no tools). Landing file for dotnet tool install --local. Default on. Every create; paths do not collide. Test and benchmark projects are not affected. Does not restore tools on build.",
      "displayName": "Empty local dotnet-tools.json"
    }
  },
  // Registers XML-style conditionals for extensions that hosts do not always
  // treat the same as the built-in XML/.md processor. Tokens must sit on their
  // own lines because wholeLine is true. .targets stays registered for
  // generate-time conditionals in Properties/Build if any are added later.
  // .txt / LICENSE: each TemplateAssets/Licenses seed uses a shallow
  // //#if (PackageCopyrightHolderIsSet) / //#else / //#endif. Do not put
  // ProjectLicense #if in those files; extra sources pick the seed.
  "specialCustomOperations": {
    "**/*.txt": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "//#if" ],
            "else": [ "//#else" ],
            "elseif": [ "//#elseif" ],
            "endif": [ "//#endif" ],
            "trim": true,
            "wholeLine": true,
            "evaluator": "C++"
          }
        }
      ]
    },
    "**/LICENSE": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "//#if" ],
            "else": [ "//#else" ],
            "elseif": [ "//#elseif" ],
            "endif": [ "//#endif" ],
            "trim": true,
            "wholeLine": true,
            "evaluator": "C++"
          }
        }
      ]
    },
    "**/*.slnx": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "<!--#if" ],
            "else": [ "<!--#else" ],
            "elseif": [ "<!--#elseif" ],
            "endif": [ "<!--#endif" ],
            "trim": true,
            "wholeLine": true,
            "evaluator": "C++"
          }
        }
      ]
    },
    "**/*.md": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "<!--#if" ],
            "else": [ "<!--#else" ],
            "elseif": [ "<!--#elseif" ],
            "endif": [ "<!--#endif" ],
            "trim": true,
            "wholeLine": true,
            "evaluator": "C++"
          }
        }
      ]
    },
    "**/*.targets": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "<!--#if" ],
            "else": [ "<!--#else" ],
            "elseif": [ "<!--#elseif" ],
            "endif": [ "<!--#endif" ],
            "trim": true,
            "wholeLine": true,
            "evaluator": "C++"
          }
        }
      ]
    }
  },
  // Sources: optional files plus solution placement.
  // The template always starts from __SourceName__.generated.slnx at the
  // template root. Paths inside that file follow PlaceSolution
  // (SlnFolder / RepoRoot / BesideCsproj).
  // Handbook seed is src/sln/__SourceName__/Readme.md. SlnFolder and RepoRoot
  // keep it there. BesideCsproj renames it next to the csproj and does not
  // create src/sln/{name}/ (the nested .gitignore is already excluded).
  //
  // SlnFolder → src/sln/__SourceName__/__SourceName__.slnx (CLI and VS).
  // BesideCsproj → src/prj/__SourceName__/__SourceName__.slnx (CLI and VS).
  // RepoRoot + CLI → __SourceName__.slnx at repo root.
  // RepoRoot + VS → no rename; file stays __SourceName__.generated.slnx so it
  //   does not collide with Visual Studio's {Name}.slnx at the same folder.
  "sources": [
    {
      "modifiers": [
        {
          "condition": "((InitRepoItems == \"None\") || ((InitAllRepoItems == false) && (InitRepoItems != \"Readme\")))",
          "exclude": [
            "README.md"
          ]
        },
        {
          "condition": "((InitRepoItems == \"None\") || ((InitAllRepoItems == false) && (InitRepoItems != \"AIReleaseCheckpoint\")))",
          "exclude": [
            "TEMPLATE-AI-RELEASE-CHECKPOINT.md"
          ]
        },
        {
          "condition": "((InitRepoItems == \"None\") || ((InitAllRepoItems == false) && (InitRepoItems != \"GitAttributes\")))",
          "exclude": [
            ".gitattributes"
          ]
        },
        {
          "condition": "((InitRepoItems == \"None\") || ((InitAllRepoItems == false) && (InitRepoItems != \"GitIgnore\")))",
          "exclude": [
            ".gitignore"
          ]
        },
        {
          "condition": "((InitRepoItems == \"None\") || (InitRepoItems != \"SrcGlobalJson\"))",
          "exclude": [
            "src/global.json"
          ]
        },
        {
          "condition": "(DotNetToolManifest == false)",
          "exclude": [
            "src/prj/__SourceName__/.config/dotnet-tools.json"
          ]
        },
        {
          "condition": "(BenchmarkProject == false)",
          "exclude": [
            "src/prj/__SourceName__.Benchmark/__SourceName__.Benchmark.csproj",
            "src/prj/__SourceName__.Benchmark/Program.cs",
            "src/prj/__SourceName__.Benchmark/.gitignore"
          ]
        },
        {
          "condition": "(NerdbankGitVersioning != \"Repo\")",
          "exclude": [
            "src/prj/__SourceName__/Properties/Build/NerdbankRepositoryVersion.targets",
            "src/prj/__SourceName__/Properties/Build/Nerdbank.version.json"
          ]
        },
        {
          "exclude": [
            "TemplateAssets/**"
          ]
        },
        {
          "condition": "(PlaceSolution == \"SlnFolder\")",
          "rename": {
            "__SourceName__.generated.slnx": "src/sln/__SourceName__/__SourceName__.slnx"
          }
        },
        {
          "condition": "(PlaceSolution == \"BesideCsproj\")",
          "rename": {
            "__SourceName__.generated.slnx": "src/prj/__SourceName__/__SourceName__.slnx",
            "src/sln/__SourceName__/Readme.md": "src/prj/__SourceName__/Readme.md"
          }
        },
        {
          "condition": "(PlaceSolution != \"SlnFolder\")",
          "exclude": [
            "src/sln/__SourceName__/.gitignore"
          ]
        },
        {
          "condition": "((PlaceSolution == \"RepoRoot\") && IsCliHost)",
          "rename": {
            "__SourceName__.generated.slnx": "__SourceName__.slnx"
          }
        }
      ]
    },
    {
      "source": "./TemplateAssets/Versioning/Repo/",
      "target": "./",
      "condition": "WriteRepoVersionJson"
    },
    {
      "source": "./TemplateAssets/Versioning/Project/",
      "target": "./src/prj/__SourceName__/Properties/",
      "condition": "(NerdbankGitVersioning == \"Project\")"
    },
    {
      "source": "./TemplateAssets/ProgramSamples/MinimalClassic/App/",
      "target": "./src/prj/__SourceName__/",
      "condition": "(ProgramSample == \"MinimalClassic\")"
    },
    {
      "source": "./TemplateAssets/ProgramSamples/MinimalClassic/Tests/",
      "target": "./src/prj/__SourceName__.Tests/",
      "condition": "(ProgramSample == \"MinimalClassic\")"
    },
    {
      "source": "./TemplateAssets/ProgramSamples/MinimalClassic/Benchmark/",
      "target": "./src/prj/__SourceName__.Benchmark/",
      "condition": "((ProgramSample == \"MinimalClassic\") && BenchmarkProject)"
    },
    {
      "source": "./TemplateAssets/ProgramSamples/MahAppsMvvm/App/",
      "target": "./src/prj/__SourceName__/",
      "condition": "(ProgramSample == \"MahAppsMvvm\")"
    },
    {
      "source": "./TemplateAssets/ProgramSamples/MahAppsMvvm/Tests/",
      "target": "./src/prj/__SourceName__.Tests/",
      "condition": "(ProgramSample == \"MahAppsMvvm\")"
    },
    {
      "source": "./TemplateAssets/ProgramSamples/MahAppsMvvm/Benchmark/",
      "target": "./src/prj/__SourceName__.Benchmark/",
      "condition": "((ProgramSample == \"MahAppsMvvm\") && BenchmarkProject)"
    },
    {
      "source": "./TemplateAssets/WixUserInstaller/",
      "target": "./src/prj/__SourceName__.WixSetup/",
      "condition": "(AdditionalInstaller == \"WixUserInstaller\")"
    },
    {
      "source": "./TemplateAssets/",
      "target": "./docs/",
      "condition": "WriteRepoDocTemplate",
      "modifiers": [
        {
          "exclude": [
            "Versioning/**",
            "CodeStyle/**",
            "Licenses/**",
            "DirectoryMsBuild/**",
            "ProgramSamples/**",
            "WixUserInstaller/**"
          ]
        }
      ]
    },
    {
      "source": "./TemplateAssets/CodeStyle/",
      "target": "./src/prj/__SourceName__/",
      "condition": "(ProjectEditorGlobalConfig == \"Default\")",
      "modifiers": [
        {
          "exclude": [
            ".project.editor.globalconfig.strict"
          ]
        },
        {
          "rename": {
            ".project.editor.globalconfig.default": ".project.editor.globalconfig"
          }
        }
      ]
    },
    {
      "source": "./TemplateAssets/CodeStyle/",
      "target": "./src/prj/__SourceName__/",
      "condition": "(ProjectEditorGlobalConfig == \"Strict\")",
      "modifiers": [
        {
          "exclude": [
            ".project.editor.globalconfig.default"
          ]
        },
        {
          "rename": {
            ".project.editor.globalconfig.strict": ".project.editor.globalconfig"
          }
        }
      ]
    },
    {
      "source": "./TemplateAssets/Licenses/",
      "target": "./",
      "condition": "(WriteRepoLicense && (ProjectLicense == \"MIT\"))",
      "modifiers": [
        {
          "exclude": [
            "BSD3Clause.txt",
            "Apache2.txt",
            "Custom.txt"
          ]
        },
        {
          "rename": {
            "MIT.txt": "LICENSE"
          }
        }
      ]
    },
    {
      "source": "./TemplateAssets/Licenses/",
      "target": "./",
      "condition": "(WriteRepoLicense && (ProjectLicense == \"BSD3Clause\"))",
      "modifiers": [
        {
          "exclude": [
            "MIT.txt",
            "Apache2.txt",
            "Custom.txt"
          ]
        },
        {
          "rename": {
            "BSD3Clause.txt": "LICENSE"
          }
        }
      ]
    },
    {
      "source": "./TemplateAssets/Licenses/",
      "target": "./",
      "condition": "(WriteRepoLicense && (ProjectLicense == \"Apache2\"))",
      "modifiers": [
        {
          "exclude": [
            "MIT.txt",
            "BSD3Clause.txt",
            "Custom.txt"
          ]
        },
        {
          "rename": {
            "Apache2.txt": "LICENSE"
          }
        }
      ]
    },
    {
      "source": "./TemplateAssets/Licenses/",
      "target": "./",
      "condition": "(WriteRepoLicense && (ProjectLicense == \"Custom\"))",
      "modifiers": [
        {
          "exclude": [
            "MIT.txt",
            "BSD3Clause.txt",
            "Apache2.txt"
          ]
        },
        {
          "rename": {
            "Custom.txt": "LICENSE"
          }
        }
      ]
    },
    {
      "source": "./TemplateAssets/DirectoryMsBuild/",
      "target": "./src/prj/__SourceName__/",
      "condition": "DirectoryMsBuildFiles",
      "modifiers": [
        {
          "exclude": [
            "Directory.Solution.props",
            "Directory.Solution.targets"
          ]
        }
      ]
    },
    {
      "source": "./TemplateAssets/DirectoryMsBuild/",
      "target": "./src/sln/__SourceName__/",
      "condition": "(DirectoryMsBuildFiles && (PlaceSolution == \"SlnFolder\"))",
      "modifiers": [
        {
          "exclude": [
            "Directory.Build.props",
            "Directory.Build.targets"
          ]
        }
      ]
    },
    {
      "source": "./TemplateAssets/DirectoryMsBuild/",
      "target": "./",
      "condition": "(DirectoryMsBuildFiles && (PlaceSolution == \"RepoRoot\"))",
      "modifiers": [
        {
          "exclude": [
            "Directory.Build.props",
            "Directory.Build.targets"
          ]
        }
      ]
    },
    {
      "source": "./TemplateAssets/DirectoryMsBuild/",
      "target": "./src/prj/__SourceName__/",
      "condition": "(DirectoryMsBuildFiles && (PlaceSolution == \"BesideCsproj\"))",
      "modifiers": [
        {
          "exclude": [
            "Directory.Build.props",
            "Directory.Build.targets"
          ]
        }
      ]
    }
  ],
  // Host bookkeeping only. Exactly one handbook Readme survives; it is index 0
  // for the VS open-file post action (filtered list, not declared holes).
  // Solution paths are the names AFTER source rename, BEFORE sourceName replace.
  // RepoRoot+CLI actual file is __SourceName__.slnx; primaryOutputs still names
  // the pre-CLI-rename .generated path.
  "primaryOutputs": [
    {
      "condition": "(PlaceSolution != \"BesideCsproj\")",
      "path": "src/sln/__SourceName__/Readme.md"
    },
    {
      "condition": "(PlaceSolution == \"BesideCsproj\")",
      "path": "src/prj/__SourceName__/Readme.md"
    },
    {
      "condition": "(PlaceSolution == \"SlnFolder\")",
      "path": "src/sln/__SourceName__/__SourceName__.slnx"
    },
    {
      "condition": "(PlaceSolution == \"BesideCsproj\")",
      "path": "src/prj/__SourceName__/__SourceName__.slnx"
    },
    {
      "condition": "(PlaceSolution == \"RepoRoot\")",
      "path": "__SourceName__.generated.slnx"
    }
  ],
  // Visual Studio only. CLI ignores open-file and we skip display actions there.
  // 84C0DA21 opens the surviving handbook Readme (index 0). AC1156F7 is a
  // message box after create (not run-script; that dialog appeared before create).
  "postActions": [
      {
        "condition": "(HostIdentifier == \"vs\")",
        "description": "Opens Readme.md in the editor",
        "manualInstructions": [ ],
        "actionId": "84C0DA21-51C8-4541-9940-6CA19AF04EE6",
        "args": {
          "files": "0"
        },
        "continueOnError": true
      },
      {
        "condition": "(HostIdentifier == \"vs\" && (PlaceSolution == \"SlnFolder\"))",
        "description": "Finish the repository layout",
        "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
        "manualInstructions": [
          {
            "text": "Close Visual Studio, open the .slnx under src/sln/, and delete the extra .slnx Visual Studio created in the repository root."
          }
        ],
        "continueOnError": true
      },
      {
        "condition": "(HostIdentifier == \"vs\" && (PlaceSolution == \"BesideCsproj\"))",
        "description": "Finish the repository layout",
        "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
        "manualInstructions": [
          {
            "text": "Close Visual Studio, open the .slnx next to the WPF app project under src/prj/, and delete the extra .slnx Visual Studio created in the repository root."
          }
        ],
        "continueOnError": true
      },
      {
        "condition": "(HostIdentifier == \"vs\" && (PlaceSolution == \"RepoRoot\"))",
        "description": "Finish the repository layout",
        "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
        "manualInstructions": [
          {
            "text": "Visual Studio created a conventional root .slnx. Open the .generated.slnx in the repository root for the template layout (includes sln). Delete the extra conventional .slnx if you do not need it."
          }
        ],
        "continueOnError": true
      }
  ]
}
