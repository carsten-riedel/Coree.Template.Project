{
  "$schema": "https://json.schemastore.org/ide.host",
  "symbolInfo": [
    {
      "id": "InitDefaultRepoItems",
      "isVisible": true,
      "defaultValue": "Readme|AIReleaseCheckpoint|GitAttributes",
      "persistenceScope": "none",
      "name": {
        "text": "Repository root items"
      },
      "description": {
        "text": "Root files for the first create. Visual Studio requires at least one value; choose None when adding another library to the same repository."
      }
    },
    {
      "id": "PlaceSolutionInSolutionFolder",
      "isVisible": true,
      "persistenceScope": "none",
      "name": {
        "text": "Place solution in src/sln folder"
      },
      "description": {
        "text": "Puts each .slnx next to that library's notes under src/sln/{name}/ so multiple libraries do not share one directory. Visual Studio also creates a root .slnx; close Visual Studio, open the src/sln solution, and delete the extra root .slnx."
      }
    },
    {
      "id": "TargetFrameworks",
      "isVisible": true
    },
    {
      "id": "UseWebSdk",
      "isVisible": true
    },
    {
      "id": "PackageAuthor",
      "isVisible": true
    },
    {
      "id": "PackageCopyrightHolder",
      "isVisible": true
    },
    {
      "id": "PackageCopyrightHolderIsOrganization",
      "isVisible": true
    },
    {
      "id": "PackageDescription",
      "isVisible": true
    },
    {
      "id": "CoverletMSBuild",
      "isVisible": true
    },
    {
      "id": "ReportGenerator",
      "isVisible": true
    },
    {
      "id": "BenchmarkProject",
      "isVisible": true
    }
  ]
}
