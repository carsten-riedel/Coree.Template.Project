{
  "$schema": "http://json.schemastore.org/template",
  "author": "Carsten Riedel",
  "classifications": [ "Common", "dotnet", "Windows", "Linux", "macOS", "Console" ],
  "identity": "CoreeTemplatesProjectMinimalConsoleApp",
  "name": ".NET minimal console app",
  "description": "A minimal C# console application template.",
  "shortName": "coree-console",
  "sourceName": "MinimalConsoleApp",
  "defaultName": "ConsoleApp",
  "preferNameDirectory": true,
  "symbols": {
    "Framework": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "net10.0",
      "replaces": "net10.0",
      "displayName": "Framework",
      "description": "The target .NET framework for the console app.",
      "choices": [
        {
          "choice": "net10.0",
          "displayName": ".NET 10.0 (Long Term Support)"
        },
        {
          "choice": "net8.0",
          "displayName": ".NET 8.0 (Long Term Support)"
        }
      ]
    }
  },
  "tags": {
    "language": "C#",
    "type": "project"
  }
}
