<Solution>
  <!-- Paths are relative to this file's final location.
       PlaceSolution SlnFolder      → src/sln/__SourceName__/__SourceName__.slnx
       PlaceSolution BesideCsproj  → src/prj/__SourceName__/__SourceName__.slnx
       PlaceSolution RepoRoot       → repo root, so src/prj/ and src/sln/. -->
  <Folder Name="/sln/__SourceName__/">
    <File Path="src/sln/__SourceName__/Readme.md" />
<!--#if (DirectoryMsBuildFiles) -->
    <File Path="Directory.Solution.props" />
    <File Path="Directory.Solution.targets" />
<!--#endif -->
  </Folder>
  <Folder Name="/prj/">
    <Project Path="src/prj/__SourceName__/__SourceName__.csproj" />
  </Folder>
</Solution>
