        ],
        "continueOnError": true
      },
      {
        "condition": "(HostIdentifier == \"vs\" && (PlaceSolution == \"BesideCsproj\"))",
        "description": "Finish the repository layout",
        "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
        "manualInstructions": [
          {
            "text": "Close Visual Studio, open the .slnx next to the library project under src/prj/, and delete the extra .slnx Visual Studio created in the repository root."
