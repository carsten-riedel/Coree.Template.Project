<!--#if (UseWebSdk) -->
<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk.Web" />
<!--#else -->
<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
<!--#endif -->

  <!-- General build settings: defines the output type and target framework -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>__TargetFrameworks__</TargetFrameworks>
  </PropertyGroup>

  <!-- C# language features and debugging configuration -->
  <PropertyGroup>
    <!--#if (CSharpProjectOptions == "DisableImplicitUsings") -->
    <ImplicitUsings>disable</ImplicitUsings>
    <!--#else -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!--#endif -->
    <!--#if (CSharpProjectOptions == "Nullable") -->
    <Nullable>enable</Nullable>
    <!--#else -->
    <Nullable>disable</Nullable>
    <!--#endif -->
    <!--#if (CSharpProjectOptions == "DebugEmbedded") -->
    <DebugType>embedded</DebugType>
    <!--#else -->
    <DebugType>none</DebugType>
    <!--#endif -->
    <!--#if (CSharpProjectOptions == "LangLatest") -->
    <LangVersion>latest</LangVersion>
    <!--#else -->
    <LangVersion>default</LangVersion>
    <!--#endif -->
  </PropertyGroup>

  <!-- XML documentation file -->
  <PropertyGroup>
    <!--#if (CSharpProjectOptions == "GenerateDocumentationFile") -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--#else -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--#endif -->
  </PropertyGroup>

  <!--#if (ProjectEditorGlobalConfig == true) -->
  <!-- Keep global analyzer scoped to the project directory config file on disk without showing it as a project item. -->
  <!-- EnforceCodeStyleInBuild is required or IDE1006 stays IDE-only and `dotnet build` ignores the file. -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="$(MSBuildProjectDirectory)\.project.editor.globalconfig" Visible="false" />
  </ItemGroup>
  <!--#endif -->

  <!-- Packaging and publish configuration -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <IsPublishable>false</IsPublishable>
    <PublishRelease>true</PublishRelease>
    <IsTestProject>false</IsTestProject>
    <PackAsTool>false</PackAsTool>
  </PropertyGroup>

  <!--#if (UseNerdbankGitVersioning) -->
  <!-- Versioning: Nerdbank -->
  <!--#if (NerdbankGitVersioning == "Project") -->
  <PropertyGroup>
    <GitVersionBaseDirectory>$(MSBuildProjectDirectory)\Properties</GitVersionBaseDirectory>
  </PropertyGroup>
  <!--#endif -->
  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.10.94">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <!--#else -->
  <!-- Versioning -->
  <PropertyGroup>
    <VersionMajor>0</VersionMajor>
    <VersionMinor>1</VersionMinor>
    <VersionBuild>0</VersionBuild>
    <VersionRevision>0</VersionRevision>
    <VersionPrefix>$(VersionMajor).$(VersionMinor).$(VersionBuild).$(VersionRevision)</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == '' and '$(Configuration)' == 'Debug'">prerelease</VersionSuffix>
    <PackageVersion Condition="'$(VersionSuffix)' == ''">$(VersionPrefix)</PackageVersion>
    <PackageVersion Condition="'$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</PackageVersion>
    <InformationalVersion>$(PackageVersion)</InformationalVersion>
    <AssemblyVersion>$(VersionPrefix)</AssemblyVersion>
  </PropertyGroup>
  <!--#endif -->

  <!-- Package metadata -->
  <!-- https://learn.microsoft.com/en-us/nuget/create-packages/package-authoring-best-practices -->
  <PropertyGroup>
    <Authors>MyAuthor</Authors>
    <!--#if (PackageCopyrightHolderIsSet) -->
    <Owners>MyCopyrightHolder</Owners>
    <!--#else -->
    <Owners>MyAuthor</Owners>
    <!--#endif -->
    <!--#if (PackageCopyrightHolderIsOrganization == true) -->
    <!--#if (PackageCopyrightHolderIsSet) -->
    <Company>MyCopyrightHolder</Company>
    <!--#else -->
    <Company>MyAuthor</Company>
    <!--#endif -->
    <!--#else -->
    <Company></Company>
    <!--#endif -->
    <!--#if (PackageCopyrightHolderIsSet) -->
    <Copyright>Copyright © 1975 MyCopyrightHolder</Copyright>
    <!--#else -->
    <Copyright>Copyright © 1975 MyAuthor</Copyright>
    <!--#endif -->
    <PackageId>ClassLibrary</PackageId>
    <PackageTags>dotnet;class;library</PackageTags>
    <PackageProjectUrl></PackageProjectUrl>
    <RepositoryUrl></RepositoryUrl>
    <RepositoryType></RepositoryType>
    <Description>
     <![CDATA[PackageDescription]]>
    </Description>
    <PackageReadmeFile>Readme.md</PackageReadmeFile>
    <!--#if (ProjectLicense == "MIT") -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!--#endif -->
    <!--#if (ProjectLicense == "BSD3Clause") -->
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <!--#endif -->
    <!--#if (ProjectLicense == "Apache2") -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <!--#endif -->
    <!--#if (ProjectLicense == "Custom") -->
    <PackageLicenseFile>License.txt</PackageLicenseFile>
    <!--#endif -->
    <PackageIcon>Icon-128x128.png</PackageIcon>
    <PackageReleaseNotes>$([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)\NugetAssets\ReleaseNotes.txt"))</PackageReleaseNotes>
  </PropertyGroup>

  <!-- Extra nupkg files from NugetAssets/ (readme, icon, release notes). -->
  <!-- Standard licenses: License.txt stays on disk (PackageLicenseExpression). -->
  <!-- Custom: pack License.txt as PackageLicenseFile. -->
  <ItemGroup>
    <None Include="$(MSBuildProjectDirectory)\NugetAssets\**\*" Pack="true" PackagePath="" Exclude="$(MSBuildProjectDirectory)\NugetAssets\License.txt" />
    <!--#if (ProjectLicense == "Custom") -->
    <None Include="$(MSBuildProjectDirectory)\NugetAssets\License.txt" Pack="true" PackagePath="" />
    <!--#endif -->
  </ItemGroup>

  <PropertyGroup>
    <PackageOutputPath Condition=" '$(PackageOutputPath)' == '' ">$(MSBuildProjectDirectory)\bin\Pack</PackageOutputPath>
  </PropertyGroup>

  <!-- Publish behavior keep slim for library specs -->
	<PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
		<!-- Flat publish output -->
		<PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildProjectDirectory)\bin\Publish\</PublishDir>
		<PublishAot>false</PublishAot>
		<PublishTrimmed>false</PublishTrimmed>
	</PropertyGroup>

  <!-- Publish behavior for executable future useage program main etc -->
	<PropertyGroup Condition="'$(_IsPublishing)' == 'true' and '$(OutputType)' != 'Library'">
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<PublishSelfContained>true</PublishSelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
	</PropertyGroup>

  <!-- Keep Git configuration on disk without showing it as a project item -->
  <ItemGroup>
    <None Remove=".gitignore" />
  </ItemGroup>

  <!-- Source Link git state as properties (SDK 8+). Target hooks GenerateAssemblyInfo. -->
  <Import Project="Build/SourceControlState.targets" />
  <!--#if (NerdbankGitVersioning == "Repo") -->
  <Import Project="Build/NerdbankRepositoryVersion.targets" />
  <!--#endif -->
  <!--
    Must stay last. This import is Sdk.targets plus the outer Publish dispatch.
    The SDK reads properties and items while it loads (EnforceCodeStyleInBuild,
    GlobalAnalyzerConfigFiles, publish). Anything after this line is after the
    SDK and is ignored for that. Project Sdk="..." would append Sdk.targets
    after this file and overwrite the Publish override.
  -->
  <Import Project="Build/ImportSdkTargets.targets" />

</Project>
