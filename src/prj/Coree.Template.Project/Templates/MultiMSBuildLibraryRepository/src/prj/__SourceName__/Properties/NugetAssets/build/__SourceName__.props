<Project>
  <!--
    NuGet auto-imports this file into every PackageReference consumer csproj
    (and anything that csproj imports, including Directory.Build.props/targets).
    UsingTask is the function surface. Targets that call those tasks belong in
    build/__SourceName__.targets (this file is imported first).
  -->
  <PropertyGroup>
    <_TaskFolder>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', 'tasks', 'netstandard2.0'))</_TaskFolder>
    <_TaskAssembly>$([MSBuild]::NormalizePath('$(_TaskFolder)', '$(MSBuildThisFileName).dll'))</_TaskAssembly>
  </PropertyGroup>
  <UsingTask TaskName="__SourceName__.AddTask" AssemblyFile="$(_TaskAssembly)" />
  <UsingTask TaskName="__SourceName__.TaskNodeTask" AssemblyFile="$(_TaskAssembly)" />
  <UsingTask TaskName="__SourceName__.HomeTask" AssemblyFile="$(_TaskAssembly)" />
  <UsingTask TaskName="__SourceName__.DumpEnvVarsTask" AssemblyFile="$(_TaskAssembly)" />
</Project>
