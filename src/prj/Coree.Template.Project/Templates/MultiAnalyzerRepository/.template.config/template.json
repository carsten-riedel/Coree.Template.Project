{
  "$schema": "http://json.schemastore.org/template",
  "author": "Carsten Riedel",
  // Opts Visual Studio into category display in the New Project dialog
  "classifications": [ "Common", "dotnet", "Windows", "Linux", "macOS", "Analyzer", "Roslyn", "NuGet", "Test", "Solution", "Repository", "Multi-project", "Coree" ],
  "identity": "CoreeTemplatesProjectMultiAnalyzerRepository",
  // Displayname is used in the New Project dialog and in the dotnet new list output.
  "name": ".NET multi-analyzer repository",
  "description": "Repository of one or more independently packable Roslyn analyzer packages (NuGet). Same combo and init system as the multi-library repository. Analyzer targets netstandard2.0 and packs under analyzers/dotnet/cs. Tests, Coverlet coverage, and a Visual Studio DebugHost (DebugRoslynComponent) are included; optional ReportGenerator, BenchmarkDotNet, Nerdbank.GitVersioning, Public API analyzers, and documentation template.",
  "shortName": "multianalyzerrepo-coree",
  // Host metadata: libraries this template uses that the author does not own.
  // After create, CLI prints this URL. The markdown lives next to this file;
  // .template.config *.md is not packed and is not generated into the repo.
  "thirdPartyNotices": "https://github.com/carsten-riedel/Coree.Template.Project/blob/main/src/prj/Coree.Template.Project/Templates/MultiAnalyzerRepository/.template.config/THIRD-PARTY-NOTICES.md",
  "tags": {
    "language": "C#",
    "type": "solution",
    // Opts Visual Studio into its solution-template UI instead of the project-template UI.
    "editorTreatAs": "solution"
  },
  "defaultName": "Organization.Domain.Analyzer", // Organization.Domain.Functionality
  "sourceName": "__SourceName__", // Folders, csproj, namespace. Replaced by --name.
  // Visual Studio creates the outer solution directory; true would add another name directory.
  "preferNameDirectory": false,
  // Active SDK only (`dotnet --version`). [8.0,) is 8 and later, any feature band - not 8.0.100.
  // `8.*` would hide the template on SDK 9/10. Unmet: installed but not listed / not instantiated.
  "constraints": {
    "sdk": {
      "type": "sdk-version",
      "args": "[8.0,)"
    }
  },
  "symbols": {
    // HostIdentifier is bound by the template host (dotnetcli, vs, …).
    // Default "dotnetcli" so CLI-only dry runs still evaluate CLI rename rules.
    "HostIdentifier": {
      "type": "bind",
      "binding": "host:HostIdentifier",
      "defaultValue": "dotnetcli"
    },
    // Single-select DebugHost TFM (net8.0 / net9.0 / net10.0). Tests and the
    // optional benchmark use the same value. The analyzer is always netstandard2.0.
    // First parameter after HostIdentifier so Visual Studio lists it at the top.
    "TargetFrameworks": {
      "type": "parameter",
      "description": "DebugHost target framework (.NET 8, 9, or 10). Tests and the optional benchmark use the same TFM. The analyzer package always targets netstandard2.0.",
      "datatype": "choice",
      "allowMultipleValues": false,
      "enableQuotelessLiterals": true,
      "displayName": "DebugHost target framework",
      "choices": [
        {
          "choice": "net8.0",
          "description": "DebugHost, tests, and benchmark on .NET 8",
          "displayName": ".NET 8"
        },
        {
          "choice": "net9.0",
          "description": "DebugHost, tests, and benchmark on .NET 9",
          "displayName": ".NET 9"
        },
        {
          "choice": "net10.0",
          "description": "DebugHost, tests, and benchmark on .NET 10",
          "displayName": ".NET 10"
        }
      ],
      "defaultValue": "net10.0"
    },
    // Converts the selected framework values to the semicolon-separated MSBuild list.
    "TargetFrameworksValue": {
      "type": "generated",
      "generator": "join",
      "replaces": "__TargetFrameworks__",
      "parameters": {
        "symbols": [
          {
            "type": "ref",
            "value": "TargetFrameworks"
          }
        ],
        "separator": ";",
        "removeEmptyValues": true
      }
    },
    // Resolves the selected framework to one value for paths and filenames.
    "TargetFrameworkValue": {
      "type": "generated",
      "generator": "switch",
      "replaces": "__TargetFramework__",
      "parameters": {
        "datatype": "string",
        "cases": [
          {
            "condition": "(TargetFrameworks == \"net10.0\")",
            "value": "net10.0"
          },
          {
            "condition": "(TargetFrameworks == \"net9.0\")",
            "value": "net9.0"
          },
          {
            "condition": "(TargetFrameworks == \"net8.0\")",
            "value": "net8.0"
          }
        ]
      }
    },
    // Same order as TargetFrameworkValue. Pins src/global.json sdk.version
    // to the DebugHost TFM (8.0.0 / 9.0.0 / 10.0.0), not netstandard2.0.
    // Placeholder must not appear elsewhere.
    "SdkPinVersion": {
      "type": "generated",
      "generator": "switch",
      "replaces": "0.0.0-sdk-pin",
      "parameters": {
        "datatype": "string",
        "cases": [
          {
            "condition": "(TargetFrameworks == \"net10.0\")",
            "value": "10.0.0"
          },
          {
            "condition": "(TargetFrameworks == \"net9.0\")",
            "value": "9.0.0"
          },
          {
            "condition": "(TargetFrameworks == \"net8.0\")",
            "value": "8.0.0"
          }
        ]
      }
    },
    // One multi-choice instead of N root bools (VS stays one group, like InitRepoItems).
    // CLI default is empty: later libraries omit both switches, no root collisions.
    // Visual Studio does not allow an empty multi-choice (at least one value).
    // None is the explicit empty set; it is first so a host that snaps to the
    // first choice still writes no root files. None also overrides other
    // selections if the IDE leaves leftover checks on, including InitAllRepoItems.
    // Visual Studio selects the real items via ide.host.json defaultValue.
    // CLI first-create set is InitAllRepoItems (bool, hidden in VS).
    // In conditions, == means "this value is among the selected choices".
    "InitRepoItems": {
      "type": "parameter",
      "datatype": "choice",
      "allowMultipleValues": true,
      "enableQuotelessLiterals": true,
      "isRequired": false,
      "defaultValue": "",
      "description": "Pick individual first-create files. Omit on later packages in the same folder. For the full first-create set on CLI, use --InitAllRepoItems. src/global.json is optional and off by default (not in that set). Visual Studio cannot leave this empty: choose None.",
      "displayName": "Repository root items",
      "choices": [
        {
          "choice": "None",
          "description": "Do not add first-create files. Use this in Visual Studio when adding another analyzer package to an existing repository.",
          "displayName": "None"
        },
        {
          "choice": "Readme",
          "description": "Add README.md at the top of the repository.",
          "displayName": "README.md"
        },
        {
          "choice": "AIReleaseCheckpoint",
          "description": "Add TEMPLATE-AI-RELEASE-CHECKPOINT.md. Complete it from the product (yourself or with an assistant) before the first publish, then delete it.",
          "displayName": "AI-supported release checkpoint"
        },
        {
          "choice": "GitAttributes",
          "description": "Add .gitattributes at the top of the repository.",
          "displayName": ".gitattributes"
        },
        {
          "choice": "GitIgnore",
          "description": "Add .gitignore at the top of the repository. Nested src/prj and src/sln ignores stay. First create only.",
          "displayName": ".gitignore"
        },
        {
          "choice": "RepoLicense",
          "description": "Copy the selected project license into a LICENSE file at the repository root (GitHub convention). First repository create only.",
          "displayName": "LICENSE file at repository root"
        },
        {
          "choice": "SrcGlobalJson",
          "description": "Add src/global.json pinning the .NET SDK to this create's DebugHost target framework (8.0.0, 9.0.0, or 10.0.0; rollForward latestFeature). Optional; off by default; not part of --InitAllRepoItems. First create only. Walk-up from folders under src/. Does not pin commands run at the repository root. The analyzer package stays netstandard2.0.",
          "displayName": "src/global.json"
        }
      ]
    },
    // CLI-only first-create set: README, checkpoint, .gitattributes, .gitignore,
    // LICENSE. Same five files as the Visual Studio ide.host default. Hidden in VS.
    // src/global.json is not in this set (SrcGlobalJson, default off).
    // None on InitRepoItems still writes nothing. Root version.json is not
    // in this set; it is --NerdbankGitVersioning Repo plus first-create Init
    // (WriteRepoVersionJson).
    "InitAllRepoItems": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "description": "Add all repository-root files (README.md, AI-supported release checkpoint, .gitattributes, .gitignore, LICENSE). Same set as a Visual Studio first create. Does not add version.json or src/global.json. First create only.",
      "displayName": "All repository root items"
    },
    // Where the TEMPLATE .slnx is written.
    // SlnFolder (default): src/sln/__SourceName__/__SourceName__.slnx plus
    // handbook Readme.md - one folder per package so `dotnet` there does not
    // see sibling .slnx files.
    // BesideCsproj: src/prj/__SourceName__/ next to the packable analyzer
    // csproj (slnx + handbook; tests, DebugHost, and benchmark stay sibling
    // projects under src/prj/). Does not create src/sln/{name}/.
    // RepoRoot: repository root. CLI renames to __SourceName__.slnx; Visual
    // Studio keeps __SourceName__.generated.slnx so it does not overwrite the
    // IDE's conventional {Name}.slnx. src/sln/{name}/Readme.md is still notes.
    // RepoRoot stacks every package's .slnx in one directory; CLI/CI must pass
    // a solution path if more than one exists.
    "PlaceSolution": {
      "type": "parameter",
      "datatype": "choice",
      "isRequired": false,
      "defaultValue": "SlnFolder",
      "enableQuotelessLiterals": true,
      "description": "Where this analyzer's .slnx is written. Default src/sln/{name}/ (handbook beside that file). BesideCsproj writes the .slnx and handbook next to the analyzer csproj and does not create src/sln/{name}/. Do not collect several .slnx files in one directory: `dotnet` then requires an explicit path (MSB1011).",
      "displayName": "Solution file location",
      "choices": [
        {
          "choice": "SlnFolder",
          "description": "Default. One .slnx per package folder so `dotnet` does not ask which file to use.",
          "displayName": "src/sln/{name}/"
        },
        {
          "choice": "RepoRoot",
          "description": "Repository root. Later packages share that directory, so `dotnet` needs the .slnx path (MSB1011).",
          "displayName": "Repository root"
        },
        {
          "choice": "BesideCsproj",
          "description": "Next to this analyzer's csproj (slnx and handbook). Does not create src/sln/{name}/. Tests, DebugHost, and benchmark stay sibling projects under src/prj/.",
          "displayName": "src/prj/{name}/"
        }
      ]
    },
    // True for dotnet new / preview CLI. Used so only CLI renames
    // .generated.slnx → __SourceName__.slnx at repo root when PlaceSolution is
    // RepoRoot. Visual Studio keeps the .generated name and therefore does
    // not overwrite its own root .slnx.
    "IsCliHost": {
      "type": "computed",
      "value": "(HostIdentifier == \"dotnetcli\" || HostIdentifier == \"dotnetcli-preview\")"
    },
    // One multi-choice for C# / debug / documentation in the analyzer, tests, DebugHost, and
    // benchmark (VS combobox, like InitRepoItems). Checked =
    // current product default. Unchecked = the other explicit value.
    // Properties are always written. GenerateDocumentationFile is in this
    // choice list; only the analyzer project writes it (own PropertyGroup).
    // Tests/Benchmark have no XML docs surface. No None: CLI/VS default is
    // the five product values; Visual Studio keeps at least one checked.
    // Omit the switch on CLI.
    "CSharpProjectOptions": {
      "type": "parameter",
      "datatype": "choice",
      "allowMultipleValues": true,
      "enableQuotelessLiterals": true,
      "isRequired": false,
      "defaultValue": "DisableImplicitUsings|Nullable|LangLatest|DebugEmbedded|GenerateDocumentationFile",
      "description": "C# and debug settings for the analyzer package, tests, DebugHost, and benchmark. Uncheck an item to write the alternative value.",
      "displayName": "C# project options",
      "choices": [
        {
          "choice": "DisableImplicitUsings",
          "description": "Do not add global implicit usings. Uncheck to enable them.",
          "displayName": "Disable implicit usings"
        },
        {
          "choice": "Nullable",
          "description": "Enable nullable reference types. Uncheck to disable them.",
          "displayName": "Nullable"
        },
        {
          "choice": "LangLatest",
          "description": "Use the newest C# the installed SDK understands. Uncheck for the TFM default.",
          "displayName": "Latest language version"
        },
        {
          "choice": "DebugEmbedded",
          "description": "Embed portable PDBs in the assembly. Uncheck for no debug symbols.",
          "displayName": "Embedded debug symbols"
        },
        {
          "choice": "GenerateDocumentationFile",
          "description": "Emit an XML documentation file. Uncheck to skip it.",
          "displayName": "XML documentation file"
        }
      ]
    },
    // Author / copyright placeholders (assembly and NuGet).
    "Author": {
      "type": "parameter",
      "dataType": "string",
      "replaces": "MyAuthor",
      "description": "The author of the project. Writes Authors and, when empty, the copyright holder fallback.",
      "displayName": "Author",
      "isRequired": "true"
    },
    "PackageCopyrightHolder": {
      "type": "parameter",
      "dataType": "string",
      "defaultValue": "",
      "replaces": "MyCopyrightHolder",
      "description": "Copyright holder for the assembly, license, and package. Defaults to the author when empty.",
      "displayName": "Copyright holder"
    },
    "PackageCopyrightHolderIsSet": {
      "type": "computed",
      "value": "(PackageCopyrightHolder != \"\")"
    },
    "PackageCopyrightHolderIsOrganization": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "description": "Set when the copyright holder is an organization. Controls the Company property.",
      "displayName": "Copyright holder is an organization"
    },
    // Date generators replace fixed template placeholders in project metadata and package assets.
    "copyrightYear": {
      "type": "generated",
      "generator": "now",
      "replaces": "1975",
      "parameters": {
        "format": "yyyy"
      }
    },
    "datenowsort": {
      "type": "generated",
      "generator": "now",
      "replaces": "1975-01-01",
      "parameters": {
        "format": "yyyy-MM-dd"
      }
    },
    // Single choice (dropdown). Default Project = version.json under
    // Properties/. Combo-safe: later libraries do not collide. Off keeps
    // the VersionPrefix group. Repo uses one root version.json (first
    // create only via WriteRepoVersionJson), not the choice by itself.
    "NerdbankGitVersioning": {
      "type": "parameter",
      "datatype": "choice",
      "isRequired": false,
      "defaultValue": "Project",
      "enableQuotelessLiterals": true,
      "description": "Nerdbank.GitVersioning. Default is this library (version.json under Properties/). This repository uses one version.json at the repo root (first create only). Off keeps VersionPrefix in the library project (no extra package).",
      "displayName": "Nerdbank.GitVersioning",
      "choices": [
        {
          "choice": "Project",
          "description": "Add Nerdbank.GitVersioning with version.json in this library's Properties folder. Default. Every create; paths do not collide.",
          "displayName": "This library (Properties/version.json)"
        },
        {
          "choice": "Repo",
          "description": "Add Nerdbank.GitVersioning using a repository-root version.json. The file is written only on a first create (--InitAllRepoItems or Visual Studio root items). Later libraries pass --NerdbankGitVersioning Repo without Init*.",
          "displayName": "This repository (root version.json)"
        },
        {
          "choice": "Off",
          "description": "VersionMajor / VersionPrefix / PackageVersion in the analyzer csproj. No Nerdbank.GitVersioning package.",
          "displayName": "Off (VersionPrefix in the library project)"
        }
      ]
    },
    "UseNerdbankGitVersioning": {
      "type": "computed",
      "value": "(NerdbankGitVersioning == \"Project\" || NerdbankGitVersioning == \"Repo\")"
    },
    "WriteRepoVersionJson": {
      "type": "computed",
      "value": "(NerdbankGitVersioning == \"Repo\") && (InitRepoItems != \"None\") && (InitAllRepoItems || (InitRepoItems == \"Readme\") || (InitRepoItems == \"AIReleaseCheckpoint\") || (InitRepoItems == \"GitAttributes\") || (InitRepoItems == \"GitIgnore\") || (InitRepoItems == \"RepoLicense\") || (InitRepoItems == \"SrcGlobalJson\"))"
    },
    "WriteRepoLicense": {
      "type": "computed",
      "value": "(InitRepoItems != \"None\") && (InitAllRepoItems || (InitRepoItems == \"RepoLicense\"))"
    },
    "WriteSrcGlobalJson": {
      "type": "computed",
      "value": "(InitRepoItems != \"None\") && (InitRepoItems == \"SrcGlobalJson\")"
    },
    // Analyzer-only. Default off. First real build writes Properties/PublicAPI
    // baseline files if they are missing. Not a repository-root Init* item.
    "PublicApiAnalyzers": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "description": "Add Microsoft.CodeAnalysis.PublicApiAnalyzers to the analyzer project. The first real build writes Properties/PublicAPI baseline files if they are missing. Test and benchmark projects are not affected.",
      "displayName": "Public API analyzers"
    },
    // Multi-choice. Default empty/None. Same DocShell.html seed, two
    // destinations. Package is per library (no combo collision). Repository
    // is repo-root docs/ and collides on a later library (Exit 73).
    // Not part of InitAllRepoItems. Do not vendor the 25-file site here:
    // bootstrap follows DocShell.html and takes the versions it pins then.
    "DocumentationTemplate": {
      "type": "parameter",
      "datatype": "choice",
      "allowMultipleValues": true,
      "enableQuotelessLiterals": true,
      "isRequired": false,
      "defaultValue": "",
      "description": "Optional offline documentation template (DocShell.html). Package writes it under this library's Properties/NugetMetadata/docs (packed with the nupkg). Repository writes it under repo-root docs/ (first create only). None writes nothing. Bootstrap and mini docs are a checkpoint task, not generate-time.",
      "displayName": "Documentation template",
      "choices": [
        {
          "choice": "None",
          "description": "Do not add a documentation template.",
          "displayName": "None"
        },
        {
          "choice": "Package",
          "description": "Add DocShell.html under this library's Properties/NugetMetadata/docs. Every create; paths do not collide. Packed with the nupkg.",
          "displayName": "NuGet package docs (Properties/NugetMetadata/docs)"
        },
        {
          "choice": "Repository",
          "description": "Add DocShell.html under docs/ at the repository root. First create only; a later library in the same folder that selects this again is Exit 73.",
          "displayName": "Repository docs (docs/)"
        }
      ]
    },
    "WritePackageDocTemplate": {
      "type": "computed",
      "value": "(DocumentationTemplate == \"Package\") && (DocumentationTemplate != \"None\")"
    },
    "WriteRepoDocTemplate": {
      "type": "computed",
      "value": "(DocumentationTemplate == \"Repository\") && (DocumentationTemplate != \"None\")"
    },
    // Project / NuGet license. Single choice. MIT first and default.
    // Standard licenses: PackageLicenseExpression; no project License.txt.
    // Custom: copyright-only License.txt packed as PackageLicenseFile.
    // Repo root LICENSE is InitRepoItems RepoLicense or InitAllRepoItems, not this dropdown.
    "ProjectLicense": {
      "type": "parameter",
      "datatype": "choice",
      "isRequired": false,
      "defaultValue": "MIT",
      "description": "License for the analyzer package. Default MIT. Standards set PackageLicenseExpression and do not create a project License.txt. Custom creates and packs License.txt. The LICENSE file at repository root copies this license.",
      "displayName": "Project license",
      "choices": [
        {
          "choice": "MIT",
          "description": "MIT. PackageLicenseExpression MIT. No project License.txt.",
          "displayName": "MIT"
        },
        {
          "choice": "BSD3Clause",
          "description": "BSD 3-Clause. PackageLicenseExpression BSD-3-Clause. No project License.txt.",
          "displayName": "BSD 3-Clause"
        },
        {
          "choice": "Apache2",
          "description": "Apache 2.0. PackageLicenseExpression Apache-2.0. No project License.txt.",
          "displayName": "Apache 2.0"
        },
        {
          "choice": "Custom",
          "description": "Copyright only (all rights reserved until you add terms). Writes License.txt and packs it as PackageLicenseFile.",
          "displayName": "Custom (License.txt)"
        }
      ]
    },
    // Library-only .project.editor.globalconfig via GlobalAnalyzerConfigFiles.
    // Strict (default) is the VS style dump plus public-release build gates
    // (naming/XML/nullable/unused usings as error). Default is the same dump
    // with suggestions only. Off writes nothing. Generated disk name is always
    // .project.editor.globalconfig; seeds live under TemplateAssets/CodeStyle/
    // as .project.editor.globalconfig.{choice}. Wire it in the analyzer csproj;
    // EnforceCodeStyleInBuild is required or IDE naming
    // stays IDE-only. OptimizeImplicitlyTriggeredBuild=false so VS Test
    // Explorer / F5 do not skip those analyzers (`dotnet test` does not).
    "ProjectEditorGlobalConfig": {
      "type": "parameter",
      "datatype": "choice",
      "isRequired": false,
      "defaultValue": "Strict",
      "enableQuotelessLiterals": true,
      "description": "Editor and analyzer rules beside the analyzer project, applied in the IDE and on build. Default is Strict: naming, XML docs, nullable, and unused usings fail the build. Default (style suggestions) is the same dump without those errors. Off writes no file. Test and benchmark projects are not affected.",
      "displayName": "Code style rules for analyzer project",
      "choices": [
        {
          "choice": "Strict",
          "description": "Same style dump as Default, plus naming/XML-doc/nullable/unused-using errors for a packable analyzer. Default. Needs XML docs and nullable on in C# project options.",
          "displayName": "Strict (public release errors)"
        },
        {
          "choice": "Default",
          "description": "VS style dump as .project.editor.globalconfig. Naming and style stay suggestions. EnforceCodeStyleInBuild and OptimizeImplicitlyTriggeredBuild=false are still on.",
          "displayName": "Default (style suggestions)"
        },
        {
          "choice": "Off",
          "description": "Do not add .project.editor.globalconfig, EnforceCodeStyleInBuild, or OptimizeImplicitlyTriggeredBuild.",
          "displayName": "Off (no code style file)"
        }
      ]
    },
    "UseProjectEditorGlobalConfig": {
      "type": "computed",
      "value": "(ProjectEditorGlobalConfig != \"Off\")"
    },
    // Default/Off keep unused usings on EmDashAnalyzer so IDE0005 is visible.
    // Strict omits them or the first build fails (IDE0005 is error).
    "KeepScaffoldUnusedUsings": {
      "type": "computed",
      "value": "(ProjectEditorGlobalConfig != \"Strict\")"
    },
    // Library-only SDK CA rule set (AnalysisMode). Not style/CS (that is
    // ProjectEditorGlobalConfig) and not Public API analyzers. Recommended
    // is the omit-the-switch default. Always written so the generated csproj
    // does not follow a later SDK Default shift. Tests and benchmark omit it.
    "AnalysisMode": {
      "type": "parameter",
      "datatype": "choice",
      "isRequired": false,
      "defaultValue": "Recommended",
      "enableQuotelessLiterals": true,
      "replaces": "__AnalysisMode__",
      "description": "SDK code-analysis mode for the analyzer project (CA rules). Default Recommended. Minimum is fewer warnings. All is almost every CA rule as a warning. Test and benchmark projects are not affected.",
      "displayName": "Code analysis mode",
      "choices": [
        {
          "choice": "Recommended",
          "description": "Enable the SDK recommended CA rules as build warnings. Default.",
          "displayName": "Recommended"
        },
        {
          "choice": "Minimum",
          "description": "Fewer CA rules than Recommended; highly recommended warnings only.",
          "displayName": "Minimum"
        },
        {
          "choice": "All",
          "description": "Almost every CA rule as a build warning. Noisier on a new library.",
          "displayName": "All"
        }
      ]
    },
    // Library-only. Default on. Restore NuGetAudit is already on; this promotes
    // high (NU1903) and critical (NU1904) to errors. Low/moderate stay warnings.
    // Off is for EOL/backport graphs that cannot be cleaned. Tests and
    // benchmark are not in this switch. Combo-safe.
    "NuGetAuditHighCriticalAsErrors": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "true",
      "description": "Treat high and critical NuGet vulnerability warnings (NU1903, NU1904) as restore errors on the analyzer package. Default on. Low and moderate stay warnings. Turn off for an EOL or backport graph that cannot be cleaned. Test and benchmark projects are not affected. Does not change NuGetAudit (already on) or the test-project vulnerable report.",
      "displayName": "Treat high/critical NuGet vulnerabilities as errors"
    },
    // Test-project coverage. Single choice because ReportGenerator consumes
    // Coverlet output: Report-without-Coverlet is a dead combo. Default
    // Coverlet (combo-safe, coverage stats on dotnet test). ReportGenerator
    // is opt-in presentation. Computed CoverletMSBuild / ReportGenerator
    // keep the existing csproj and sln-readme #if names.
    "TestCoverage": {
      "type": "parameter",
      "datatype": "choice",
      "isRequired": false,
      "defaultValue": "Coverlet",
      "enableQuotelessLiterals": true,
      "description": "Test coverage on the test project. Default is Coverlet: dotnet test fails if the analyzer assembly is under 100% line/branch/method coverage. Lower Threshold in the test csproj if you want less. Coverlet and ReportGenerator also writes HTML/Markdown. None writes no extra test packages. The analyzer project is not affected.",
      "displayName": "Test coverage",
      "choices": [
        {
          "choice": "Coverlet",
          "description": "Add coverlet.msbuild and collect coverage on dotnet test. Default. Fails the test run below 100% line/branch/method on the analyzer assembly. Lower Threshold in the test csproj to allow less. Raw Coverlet output only.",
          "displayName": "Coverlet only (100% gate)"
        },
        {
          "choice": "CoverletAndReport",
          "description": "Coverlet plus ReportGenerator HTML/Markdown from the Coverlet output, one folder per target framework. Same 100% coverage gate as Coverlet only.",
          "displayName": "Coverlet and ReportGenerator (100% gate)"
        },
        {
          "choice": "None",
          "description": "No Coverlet and no ReportGenerator. Tests still run.",
          "displayName": "None (no coverage)"
        }
      ]
    },
    "CoverletMSBuild": {
      "type": "computed",
      "value": "(TestCoverage != \"None\")"
    },
    "ReportGenerator": {
      "type": "computed",
      "value": "(TestCoverage == \"CoverletAndReport\")"
    },
    // Keeps BenchmarkDotNet isolated in an optional executable project.
    "BenchmarkProject": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "description": "Add an optional BenchmarkDotNet console project.",
      "displayName": "Add optional BenchmarkDotNet console project"
    },
    // Opt-in empty Directory.Build.props/.targets next to this analyzer csproj
    // and Directory.Solution.props/.targets next to this package's .slnx
    // (src/sln/{name}/, repo root, or src/prj/{name}/ - follows PlaceSolution).
    // Combo-safe when the .slnx is not stacked in one shared directory.
    // Not Init. No Directory.Packages.props (CPM would not cover sibling tests).
    // Tests, DebugHost, and benchmark are not in this switch. Default off.
    "DirectoryMsBuildFiles": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "description": "Add empty Directory.Build.props and Directory.Build.targets beside this analyzer project, and Directory.Solution.props and Directory.Solution.targets beside this package's .slnx (follows PlaceSolution). Landing files for extra MSBuild you do not want in the csproj. Test and benchmark projects are not affected. Default off.",
      "displayName": "Empty Directory.Build and Directory.Solution MSBuild files"
    },
    // Empty local tool manifest beside this analyzer csproj. Default on.
    // Combo-safe: path includes the package name. Not Init. No tools pinned
    // and no tool restore on build. Tests, DebugHost, and benchmark are not
    // in this switch.
    "DotNetToolManifest": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "true",
      "description": "Add an empty .config/dotnet-tools.json beside this analyzer project (no tools). Landing file for dotnet tool install --local. Default on. Every create; paths do not collide. Test, DebugHost, and benchmark projects are not affected. Does not restore tools on build.",
      "displayName": "Empty local dotnet-tools.json"
    }
  },
  // Registers XML-style conditionals for extensions that hosts do not always
  // treat the same as the built-in XML/.md processor. Tokens must sit on their
  // own lines because wholeLine is true. .targets stays registered so later
  // generate-time hash-if in Properties/Build/*.targets still evaluate.
  // .txt / LICENSE: each TemplateAssets/Licenses seed uses a shallow
  // //#if (PackageCopyrightHolderIsSet) / //#else / //#endif. Do not put
  // ProjectLicense #if in those files; extra sources pick the seed.
  "specialCustomOperations": {
    "**/*.txt": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "//#if" ],
            "else": [ "//#else" ],
            "elseif": [ "//#elseif" ],
            "endif": [ "//#endif" ],
            "trim": true,
            "wholeLine": true,
            "evaluator": "C++"
          }
        }
      ]
    },
    "**/LICENSE": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "//#if" ],
            "else": [ "//#else" ],
            "elseif": [ "//#elseif" ],
            "endif": [ "//#endif" ],
            "trim": true,
            "wholeLine": true,
            "evaluator": "C++"
          }
        }
      ]
    },
    "**/*.slnx": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "<!--#if" ],
            "else": [ "<!--#else" ],
            "elseif": [ "<!--#elseif" ],
            "endif": [ "<!--#endif" ],
            "trim": true,
            "wholeLine": true,
            "evaluator": "C++"
          }
        }
      ]
    },
    "**/*.md": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "<!--#if" ],
            "else": [ "<!--#else" ],
            "elseif": [ "<!--#elseif" ],
            "endif": [ "<!--#endif" ],
            "trim": true,
            "wholeLine": true,
            "evaluator": "C++"
          }
        }
      ]
    },
    "**/*.targets": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "<!--#if" ],
            "else": [ "<!--#else" ],
            "elseif": [ "<!--#elseif" ],
            "endif": [ "<!--#endif" ],
            "trim": true,
            "wholeLine": true,
            "evaluator": "C++"
          }
        }
      ]
    }
  },
  // Sources: optional files plus solution placement.
  // The template always starts from __SourceName__.generated.slnx at the
  // template root. Paths inside that file follow PlaceSolution
  // (SlnFolder / RepoRoot / BesideCsproj).
  // Handbook seed is src/sln/__SourceName__/Readme.md. SlnFolder and RepoRoot
  // keep it there. BesideCsproj renames it next to the csproj and does not
  // create src/sln/{name}/ (the nested .gitignore is already excluded).
  //
  // SlnFolder → src/sln/__SourceName__/__SourceName__.slnx (CLI and VS).
  // BesideCsproj → src/prj/__SourceName__/__SourceName__.slnx (CLI and VS).
  // RepoRoot + CLI → __SourceName__.slnx at repo root.
  // RepoRoot + VS → no rename; file stays __SourceName__.generated.slnx so it
  //   does not collide with Visual Studio's {Name}.slnx at the same folder.
  "sources": [
    {
      "modifiers": [
        {
          "condition": "((InitRepoItems == \"None\") || ((InitAllRepoItems == false) && (InitRepoItems != \"Readme\")))",
          "exclude": [
            "README.md"
          ]
        },
        {
          "condition": "((InitRepoItems == \"None\") || ((InitAllRepoItems == false) && (InitRepoItems != \"AIReleaseCheckpoint\")))",
          "exclude": [
            "TEMPLATE-AI-RELEASE-CHECKPOINT.md"
          ]
        },
        {
          "condition": "((InitRepoItems == \"None\") || ((InitAllRepoItems == false) && (InitRepoItems != \"GitAttributes\")))",
          "exclude": [
            ".gitattributes"
          ]
        },
        {
          "condition": "((InitRepoItems == \"None\") || ((InitAllRepoItems == false) && (InitRepoItems != \"GitIgnore\")))",
          "exclude": [
            ".gitignore"
          ]
        },
        {
          "condition": "((InitRepoItems == \"None\") || (InitRepoItems != \"SrcGlobalJson\"))",
          "exclude": [
            "src/global.json"
          ]
        },
        {
          "condition": "(DotNetToolManifest == false)",
          "exclude": [
            "src/prj/__SourceName__/.config/dotnet-tools.json"
          ]
        },
        {
          "condition": "(BenchmarkProject == false)",
          "exclude": [
            "src/prj/__SourceName__.Benchmark/__SourceName__.Benchmark.csproj",
            "src/prj/__SourceName__.Benchmark/Program.cs",
            "src/prj/__SourceName__.Benchmark/.gitignore"
          ]
        },
        {
          "condition": "(NerdbankGitVersioning != \"Repo\")",
          "exclude": [
            "src/prj/__SourceName__/Properties/Build/NerdbankRepositoryVersion.targets",
            "src/prj/__SourceName__/Properties/Build/Nerdbank.version.json"
          ]
        },
        {
          "condition": "(PublicApiAnalyzers == false)",
          "exclude": [
            "src/prj/__SourceName__/Properties/Build/InitializePublicApi.targets"
          ]
        },
        {
          "exclude": [
            "TemplateAssets/**"
          ]
        },
        {
          "condition": "(PlaceSolution == \"SlnFolder\")",
          "rename": {
            "__SourceName__.generated.slnx": "src/sln/__SourceName__/__SourceName__.slnx"
          }
        },
        {
          "condition": "(PlaceSolution == \"BesideCsproj\")",
          "rename": {
            "__SourceName__.generated.slnx": "src/prj/__SourceName__/__SourceName__.slnx",
            "src/sln/__SourceName__/Readme.md": "src/prj/__SourceName__/Readme.md"
          }
        },
        {
          "condition": "(PlaceSolution != \"SlnFolder\")",
          "exclude": [
            "src/sln/__SourceName__/.gitignore"
          ]
        },
        {
          "condition": "((PlaceSolution == \"RepoRoot\") && IsCliHost)",
          "rename": {
            "__SourceName__.generated.slnx": "__SourceName__.slnx"
          }
        }
      ]
    },
    {
      "source": "./TemplateAssets/Versioning/Repo/",
      "target": "./",
      "condition": "WriteRepoVersionJson"
    },
    {
      "source": "./TemplateAssets/Versioning/Project/",
      "target": "./src/prj/__SourceName__/Properties/",
      "condition": "(NerdbankGitVersioning == \"Project\")"
    },
    {
      "source": "./TemplateAssets/",
      "target": "./src/prj/__SourceName__/Properties/NugetMetadata/docs/",
      "condition": "WritePackageDocTemplate",
      "modifiers": [
        {
          "exclude": [
            "Versioning/**",
            "CodeStyle/**",
            "Licenses/**",
            "DirectoryMsBuild/**"
          ]
        }
      ]
    },
    {
      "source": "./TemplateAssets/",
      "target": "./docs/",
      "condition": "WriteRepoDocTemplate",
      "modifiers": [
        {
          "exclude": [
            "Versioning/**",
            "CodeStyle/**",
            "Licenses/**",
            "DirectoryMsBuild/**"
          ]
        }
      ]
    },
    {
      "source": "./TemplateAssets/CodeStyle/",
      "target": "./src/prj/__SourceName__/",
      "condition": "(ProjectEditorGlobalConfig == \"Default\")",
      "modifiers": [
        {
          "exclude": [
            ".project.editor.globalconfig.strict"
          ]
        },
        {
          "rename": {
            ".project.editor.globalconfig.default": ".project.editor.globalconfig"
          }
        }
      ]
    },
    {
      "source": "./TemplateAssets/CodeStyle/",
      "target": "./src/prj/__SourceName__/",
      "condition": "(ProjectEditorGlobalConfig == \"Strict\")",
      "modifiers": [
        {
          "exclude": [
            ".project.editor.globalconfig.default"
          ]
        },
        {
          "rename": {
            ".project.editor.globalconfig.strict": ".project.editor.globalconfig"
          }
        }
      ]
    },
    {
      "source": "./TemplateAssets/Licenses/",
      "target": "./src/prj/__SourceName__/Properties/NugetMetadata/",
      "condition": "(ProjectLicense == \"Custom\")",
      "modifiers": [
        {
          "exclude": [
            "MIT.txt",
            "BSD3Clause.txt",
            "Apache2.txt"
          ]
        },
        {
          "rename": {
            "Custom.txt": "License.txt"
          }
        }
      ]
    },
    {
      "source": "./TemplateAssets/Licenses/",
      "target": "./",
      "condition": "(WriteRepoLicense && (ProjectLicense == \"MIT\"))",
      "modifiers": [
        {
          "exclude": [
            "BSD3Clause.txt",
            "Apache2.txt",
            "Custom.txt"
          ]
        },
        {
          "rename": {
            "MIT.txt": "LICENSE"
          }
        }
      ]
    },
    {
      "source": "./TemplateAssets/Licenses/",
      "target": "./",
      "condition": "(WriteRepoLicense && (ProjectLicense == \"BSD3Clause\"))",
      "modifiers": [
        {
          "exclude": [
            "MIT.txt",
            "Apache2.txt",
            "Custom.txt"
          ]
        },
        {
          "rename": {
            "BSD3Clause.txt": "LICENSE"
          }
        }
      ]
    },
    {
      "source": "./TemplateAssets/Licenses/",
      "target": "./",
      "condition": "(WriteRepoLicense && (ProjectLicense == \"Apache2\"))",
      "modifiers": [
        {
          "exclude": [
            "MIT.txt",
            "BSD3Clause.txt",
            "Custom.txt"
          ]
        },
        {
          "rename": {
            "Apache2.txt": "LICENSE"
          }
        }
      ]
    },
    {
      "source": "./TemplateAssets/Licenses/",
      "target": "./",
      "condition": "(WriteRepoLicense && (ProjectLicense == \"Custom\"))",
      "modifiers": [
        {
          "exclude": [
            "MIT.txt",
            "BSD3Clause.txt",
            "Apache2.txt"
          ]
        },
        {
          "rename": {
            "Custom.txt": "LICENSE"
          }
        }
      ]
    },
    {
      "source": "./TemplateAssets/DirectoryMsBuild/",
      "target": "./src/prj/__SourceName__/",
      "condition": "DirectoryMsBuildFiles",
      "modifiers": [
        {
          "exclude": [
            "Directory.Solution.props",
            "Directory.Solution.targets"
          ]
        }
      ]
    },
    {
      "source": "./TemplateAssets/DirectoryMsBuild/",
      "target": "./src/sln/__SourceName__/",
      "condition": "(DirectoryMsBuildFiles && (PlaceSolution == \"SlnFolder\"))",
      "modifiers": [
        {
          "exclude": [
            "Directory.Build.props",
            "Directory.Build.targets"
          ]
        }
      ]
    },
    {
      "source": "./TemplateAssets/DirectoryMsBuild/",
      "target": "./",
      "condition": "(DirectoryMsBuildFiles && (PlaceSolution == \"RepoRoot\"))",
      "modifiers": [
        {
          "exclude": [
            "Directory.Build.props",
            "Directory.Build.targets"
          ]
        }
      ]
    },
    {
      "source": "./TemplateAssets/DirectoryMsBuild/",
      "target": "./src/prj/__SourceName__/",
      "condition": "(DirectoryMsBuildFiles && (PlaceSolution == \"BesideCsproj\"))",
      "modifiers": [
        {
          "exclude": [
            "Directory.Build.props",
            "Directory.Build.targets"
          ]
        }
      ]
    }
  ],
  // Host bookkeeping only. Exactly one handbook Readme survives; it is index 0
  // for the VS open-file post action (filtered list, not declared holes).
  // Solution paths are the names AFTER source rename, BEFORE sourceName replace.
  // RepoRoot+CLI actual file is __SourceName__.slnx; primaryOutputs still names
  // the pre-CLI-rename .generated path.
  "primaryOutputs": [
    {
      "condition": "(PlaceSolution != \"BesideCsproj\")",
      "path": "src/sln/__SourceName__/Readme.md"
    },
    {
      "condition": "(PlaceSolution == \"BesideCsproj\")",
      "path": "src/prj/__SourceName__/Readme.md"
    },
    {
      "condition": "(PlaceSolution == \"SlnFolder\")",
      "path": "src/sln/__SourceName__/__SourceName__.slnx"
    },
    {
      "condition": "(PlaceSolution == \"BesideCsproj\")",
      "path": "src/prj/__SourceName__/__SourceName__.slnx"
    },
    {
      "condition": "(PlaceSolution == \"RepoRoot\")",
      "path": "__SourceName__.generated.slnx"
    }
  ],
  // Visual Studio only. CLI ignores open-file and we skip display actions there.
  // 84C0DA21 opens the surviving handbook Readme (index 0). AC1156F7 is a
  // message box after create (not run-script; that dialog appeared before create).
  "postActions": [
      {
        "condition": "(HostIdentifier == \"vs\")",
        "description": "Opens Readme.md in the editor",
        "manualInstructions": [ ],
        "actionId": "84C0DA21-51C8-4541-9940-6CA19AF04EE6",
        "args": {
          "files": "0"
        },
        "continueOnError": true
      },
      {
        "condition": "(HostIdentifier == \"vs\" && (PlaceSolution == \"SlnFolder\"))",
        "description": "Finish the repository layout",
        "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
        "manualInstructions": [
          {
            "text": "Close Visual Studio, open the .slnx under src/sln/, and delete the extra .slnx Visual Studio created in the repository root."
          }
        ],
        "continueOnError": true
      },
      {
        "condition": "(HostIdentifier == \"vs\" && (PlaceSolution == \"BesideCsproj\"))",
        "description": "Finish the repository layout",
        "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
        "manualInstructions": [
          {
            "text": "Close Visual Studio, open the .slnx next to the analyzer project under src/prj/, and delete the extra .slnx Visual Studio created in the repository root."
          }
        ],
        "continueOnError": true
      },
      {
        "condition": "(HostIdentifier == \"vs\" && (PlaceSolution == \"RepoRoot\"))",
        "description": "Finish the repository layout",
        "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
        "manualInstructions": [
          {
            "text": "Visual Studio created a conventional root .slnx. Open the .generated.slnx in the repository root for the template layout (includes sln). Delete the extra conventional .slnx if you do not need it."
          }
        ],
        "continueOnError": true
      }
  ]
}
