  // Host bookkeeping only. Exactly one handbook Readme survives; it is index 0
  // for the VS open-file post action (filtered list, not declared holes).
  // Solution paths are the names AFTER source rename, BEFORE sourceName replace.
  // RepoRoot+CLI actual file is __SourceName__.slnx; primaryOutputs still names
  // the pre-CLI-rename .generated path.
  "primaryOutputs": [
    {
      "condition": "(PlaceSolution != \"BesideCsproj\")",
      "path": "src/sln/__SourceName__/Readme.md"
    },
    {
      "condition": "(PlaceSolution == \"BesideCsproj\")",
      "path": "src/prj/__SourceName__/Readme.md"
    },
    {
      "condition": "(PlaceSolution == \"SlnFolder\")",
      "path": "src/sln/__SourceName__/__SourceName__.slnx"
    },
    {
      "condition": "(PlaceSolution == \"BesideCsproj\")",
      "path": "src/prj/__SourceName__/__SourceName__.slnx"
    },
    {
      "condition": "(PlaceSolution == \"RepoRoot\")",
      "path": "__SourceName__.generated.slnx"
    }
  ],
  // Visual Studio only. CLI ignores open-file and we skip display actions there.
  // 84C0DA21 opens the surviving handbook Readme (index 0). AC1156F7 is a
  // message box after create (not run-script; that dialog appeared before create).
  "postActions": [
      {
        "condition": "(HostIdentifier == \"vs\")",
        "description": "Opens Readme.md in the editor",
        "manualInstructions": [ ],
        "actionId": "84C0DA21-51C8-4541-9940-6CA19AF04EE6",
        "args": {
