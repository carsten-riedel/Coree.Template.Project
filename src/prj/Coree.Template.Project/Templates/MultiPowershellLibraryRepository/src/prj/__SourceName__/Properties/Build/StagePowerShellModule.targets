<Project>

  <!-- Clear stale target folders before a normal multi-target build. -->
  <Target Name="PreparePowerShellModuleOutput"
          BeforeTargets="DispatchToInnerBuilds"
          Condition="'$(IsCrossTargetingBuild)' == 'true'">
    <RemoveDir Directories="$(PowerShellModuleOutputPath)" />
  </Target>

  <!-- Build output is a complete importable module tree, not a NuGet library layout. -->
  <Target Name="StagePowerShellModule"
          AfterTargets="Build"
          Condition="'$(TargetFramework)' != ''">
    <ItemGroup>
      <_PowerShellModuleAsset Include="$(MSBuildProjectDirectory)\Properties\NugetAssets\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(PowerShellModuleOutputPath)\$(TargetFramework)" />
    <Copy SourceFiles="@(_PowerShellModuleAsset)"
          DestinationFiles="@(_PowerShellModuleAsset->'$(PowerShellModuleOutputPath)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(PowerShellModuleOutputPath)\$(TargetFramework)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PowerShellModuleDependency)"
          DestinationFolder="$(PowerShellModuleOutputPath)\$(TargetFramework)"
          SkipUnchangedFiles="true"
          Condition="'@(PowerShellModuleDependency)' != ''" />
    <Message Text="Staged PowerShell module: $(PowerShellModuleOutputPath)" Importance="high" />
  </Target>

</Project>
