<Project>
  <!--
    NuGet auto-imports this file into every PackageReference consumer csproj after the project.
    UsingTask registrations live in the companion __SourceName__.props (imported first).
    DumpEnvVarsTask and AddTask stay registered; call them from a further target or Directory.Build.targets.
  -->
  <!-- MSBuild target names cannot contain dots; the template derives this prefix from the project name without dots. -->
  <Target Name="__MSBuildTargetPrefix__PopulateTaskProperties" BeforeTargets="CoreCompile">
    <HomeTask>
      <Output TaskParameter="Home" PropertyName="HomeDirectory" />
    </HomeTask>
    <TaskNodeTask>
      <Output TaskParameter="TaskNodeDir" PropertyName="TaskNodeDirectory" />
      <Output TaskParameter="TaskNodeFile" PropertyName="TaskNodeLocation" />
    </TaskNodeTask>
  </Target>
</Project>
