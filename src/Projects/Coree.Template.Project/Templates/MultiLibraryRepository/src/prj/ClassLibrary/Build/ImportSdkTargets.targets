<Project>
  <!--
    Explicit Sdk.targets close so PublishDefaultFramework.targets can run
    after the SDK (needed for switchless `dotnet publish`; see that file).
    A Project Sdk attribute would import Sdk.targets last and wipe the override.
    Nested import is conditioned: dispatch is outer-only; inner builds keep
    the real SDK Publish. UseWebSdk is a generate-time hash-if (template.json
    specialCustomOperations on *.targets), not an MSBuild condition.
  -->
  <!--#if (UseWebSdk) -->
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk.Web" />
  <!--#else -->
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <!--#endif -->
  <Import Project="$(MSBuildThisFileDirectory)PublishDefaultFramework.targets" Condition="'$(IsCrossTargetingBuild)' == 'true'" />
</Project>
