{
  "$schema": "http://json.schemastore.org/template",
  "author": "Carsten Riedel",
  // Opts Visual Studio into category display in the New Project dialog
  "classifications": [ "Common", "dotnet", "Windows", "Linux", "macOS", "ClassLibrary", "Library", "Coree", "Repository", "Multi-project" ],
  "identity": "CoreeTemplatesProjectMultiLibraryRepository",
  // Displayname is used in the New Project dialog and in the dotnet new list output.
  "name": ".NET multi-library repository",
  "description": "Repository layout for one or more packable class libraries, with an optional AI-supported release checkpoint to finish before the first publish.",
  "shortName": "multilibraryrepo-coree",
  "tags": {
    "language": "C#",
    "type": "solution",
    // Opts Visual Studio into its solution-template UI instead of the project-template UI.
    "editorTreatAs": "solution"
  },
  "defaultName": "Organization.Domain.ClassLibrary", // Organization.Domain.Functionality
  "sourceName": "ClassLibrary", // Matching nameingscheme csproj and namespace
  // Visual Studio creates the outer solution directory; true would add another name directory.
  "preferNameDirectory": false,
  "symbols": {
    // HostIdentifier is bound by the template host (dotnetcli, vs, …).
    // Default "dotnetcli" so CLI-only dry runs still evaluate CLI rename rules.
    "HostIdentifier": {
      "type": "bind",
      "binding": "host:HostIdentifier",
      "defaultValue": "dotnetcli"
    },
    // One multi-choice instead of N root bools (VS stays one group, like TFMs).
    // CLI default is empty: later libraries omit both switches, no root collisions.
    // Visual Studio does not allow an empty multi-choice (at least one value).
    // None is the explicit empty set; it is first so a host that snaps to the
    // first choice still writes no root files. None also overrides other
    // selections if the IDE leaves leftover checks on, including InitAllRepoItems.
    // Visual Studio selects the real items via ide.host.json defaultValue.
    // CLI first-create set is InitAllRepoItems (bool, hidden in VS).
    // In conditions, == means "this value is among the selected choices".
    "InitRepoItems": {
      "type": "parameter",
      "datatype": "choice",
      "allowMultipleValues": true,
      "enableQuotelessLiterals": true,
      "isRequired": false,
      "defaultValue": "",
      "description": "Pick individual repository-root files. Omit on later libraries in the same folder. For the full first-create set on CLI, use --InitAllRepoItems. Visual Studio cannot leave this empty: choose None.",
      "displayName": "Repository root items",
      "choices": [
        {
          "choice": "None",
          "description": "Do not add repository-root files. Use this in Visual Studio when adding another library to an existing repository.",
          "displayName": "None"
        },
        {
          "choice": "Readme",
          "description": "Add README.md at the top of the repository.",
          "displayName": "README.md"
        },
        {
          "choice": "AIReleaseCheckpoint",
          "description": "Add TEMPLATE-AI-RELEASE-CHECKPOINT.md. Complete it from the product (yourself or with an assistant) before the first publish, then delete it.",
          "displayName": "AI-supported release checkpoint"
        },
        {
          "choice": "GitAttributes",
          "description": "Add .gitattributes at the top of the repository.",
          "displayName": ".gitattributes"
        },
        {
          "choice": "RepoLicense",
          "description": "Copy the selected project license into a LICENSE file at the repository root (GitHub convention). First repository create only.",
          "displayName": "LICENSE file at repository root"
        }
      ]
    },
    // CLI-only first-create set: README, checkpoint, .gitattributes, LICENSE.
    // Same four files as the Visual Studio ide.host default. Hidden in VS.
    // None on InitRepoItems still writes nothing. Root version.json is not
    // in this set; it is --NerdbankGitVersioning Repo plus first-create Init
    // (WriteRepoVersionJson).
    "InitAllRepoItems": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "description": "Add all repository-root files (README.md, AI-supported release checkpoint, .gitattributes, LICENSE). Same set as a Visual Studio first create. Does not add version.json. First create only.",
      "displayName": "All repository root items"
    },
    // Where the TEMPLATE solution file is written. Default true:
    // src/sln/ClassLibrary/ClassLibrary.slnx (one folder per library so
    // `dotnet` in that directory does not see sibling .slnx files).
    // Visual Studio always also writes a root .slnx; those two do not
    // collide. When false the template solution sits at repo root, which
    // WOULD collide with Visual Studio's conventional {Name}.slnx — see
    // sources rename and ClassLibrary.generated.slnx (same trick as
    // ClassLibrarySlim). False also puts every library's .slnx in one
    // directory, so CLI/CI must pass a solution path if more than one exists.
    "PlaceSolutionInSolutionFolder": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "true",
      "description": "Place each .slnx under src/sln/{name}/. Turn off to place it at the repository root.",
      "displayName": "Place solution in the solution folder"
    },
    // True for dotnet new / preview CLI. Used so only CLI renames
    // .generated.slnx → ClassLibrary.slnx at repo root. Visual Studio keeps
    // the .generated name and therefore does not overwrite its own root .slnx.
    "IsCliHost": {
      "type": "computed",
      "value": "(HostIdentifier == \"dotnetcli\" || HostIdentifier == \"dotnetcli-preview\")"
    },
    // User-selectable target frameworks. Multiple values are supported for multi-targeting.
    "TargetFrameworks": {
      "type": "parameter",
      "description": "The target framework for the project TargetFrameworks property.",
      "datatype": "choice",
      "allowMultipleValues": true,
      "enableQuotelessLiterals": true,
      "choices": [
        {
          "choice": "net8.0",
          "description": "Target net8.0",
          "displayName": ".NET 8.0"
        },
        {
          "choice": "net9.0",
          "description": "Target net9.0",
          "displayName": ".NET 9.0"
        },
        {
          "choice": "net10.0",
          "description": "Target net10.0",
          "displayName": ".NET 10.0"
        }
      ],
      "defaultValue": "net8.0|net10.0"
    },
    // Uses the ASP.NET Core Web SDK for the library while test and benchmark projects keep their existing project roles.
    "UseWebSdk": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "description": "Use Microsoft.NET.Sdk.Web instead of Microsoft.NET.Sdk for the class library project.",
      "displayName": "Use the ASP.NET Core Web SDK"
    },
    // One multi-choice for C# / debug / documentation in library, tests, and
    // benchmark (VS combobox, like TFMs and InitRepoItems). Checked =
    // current product default. Unchecked = the other explicit value.
    // Properties are always written. GenerateDocumentationFile is in this
    // choice list; only the class library writes it (own PropertyGroup).
    // Tests/Benchmark have no XML docs surface. No None: CLI/VS default is
    // the five product values; Visual Studio keeps at least one checked.
    // Omit the switch on CLI.
    "CSharpProjectOptions": {
      "type": "parameter",
      "datatype": "choice",
      "allowMultipleValues": true,
      "enableQuotelessLiterals": true,
      "isRequired": false,
      "defaultValue": "DisableImplicitUsings|Nullable|LangLatest|DebugEmbedded|GenerateDocumentationFile",
      "description": "C# and debug settings for the class library, tests, and benchmark. Uncheck an item to write the alternative value.",
      "displayName": "C# project options",
      "choices": [
        {
          "choice": "DisableImplicitUsings",
          "description": "Do not add global implicit usings. Uncheck to enable them.",
          "displayName": "Disable implicit usings"
        },
        {
          "choice": "Nullable",
          "description": "Enable nullable reference types. Uncheck to disable them.",
          "displayName": "Nullable"
        },
        {
          "choice": "LangLatest",
          "description": "Use the newest C# the installed SDK understands. Uncheck for the TFM default.",
          "displayName": "Latest language version"
        },
        {
          "choice": "DebugEmbedded",
          "description": "Embed portable PDBs in the assembly. Uncheck for no debug symbols.",
          "displayName": "Embedded debug symbols"
        },
        {
          "choice": "GenerateDocumentationFile",
          "description": "Emit an XML documentation file. Uncheck to skip it.",
          "displayName": "XML documentation file"
        }
      ]
    },
    // Converts the selected framework values to the semicolon-separated MSBuild list.
    "TargetFrameworksValue": {
      "type": "generated",
      "generator": "join",
      "replaces": "__TargetFrameworks__",
      "parameters": {
        "symbols": [
          {
            "type": "ref",
            "value": "TargetFrameworks"
          }
        ],
        "separator": ";",
        "removeEmptyValues": true
      }
    },
    // Resolves the highest selected framework to one value for single-framework paths and filenames.
    "TargetFrameworkValue": {
      "type": "generated",
      "generator": "switch",
      "replaces": "__TargetFramework__",
      "parameters": {
        "datatype": "string",
        "cases": [
          {
            "condition": "(TargetFrameworks == \"net10.0\")",
            "value": "net10.0"
          },
          {
            "condition": "(TargetFrameworks == \"net9.0\")",
            "value": "net9.0"
          },
          {
            "condition": "(TargetFrameworks == \"net8.0\")",
            "value": "net8.0"
          }
        ]
      }
    },
    // Package metadata parameters replace their matching placeholders in the project and package assets.
    "PackageAuthor": {
      "type": "parameter",
      "dataType": "string",
      "replaces": "MyAuthor",
      "description": "The nuget package author of your project.",
      "displayName": "Package author",
      "isRequired": "true"
    },
    "PackageCopyrightHolder": {
      "type": "parameter",
      "dataType": "string",
      "defaultValue": "",
      "replaces": "MyCopyrightHolder",
      "description": "Copyright holder for the package and license. Defaults to the package author when empty.",
      "displayName": "Copyright holder"
    },
    "PackageCopyrightHolderIsSet": {
      "type": "computed",
      "value": "(PackageCopyrightHolder != \"\")"
    },
    "PackageCopyrightHolderIsOrganization": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "description": "Set when the copyright holder is an organization. Controls NuGet Company metadata only.",
      "displayName": "Copyright holder is an organization"
    },
    // Date generators replace fixed template placeholders in project metadata and package assets.
    "copyrightYear": {
      "type": "generated",
      "generator": "now",
      "replaces": "1975",
      "parameters": {
        "format": "yyyy"
      }
    },
    "datenowsort": {
      "type": "generated",
      "generator": "now",
      "replaces": "1975-01-01",
      "parameters": {
        "format": "yyyy-MM-dd"
      }
    },
    "PackageDescription": {
      "type": "parameter",
      "dataType": "string",
      "defaultValue": "PackageDescription",
      "replaces": "PackageDescription",
      "description": "The nuget package description of your project.",
      "displayName": "Package description"
    },
    // Single choice (dropdown). Default Off = existing VersionPrefix group.
    // Nerdbank is --NerdbankGitVersioning Repo or Project. Root version.json
    // is first-create only (WriteRepoVersionJson), not the choice by itself.
    "NerdbankGitVersioning": {
      "type": "parameter",
      "datatype": "choice",
      "isRequired": false,
      "defaultValue": "Off",
      "enableQuotelessLiterals": true,
      "description": "Optional Nerdbank.GitVersioning. Default Off keeps VersionPrefix in the library project (no extra package). Repo uses a repository-root version.json (first create only). Project puts version.json under Properties/.",
      "displayName": "Nerdbank.GitVersioning",
      "choices": [
        {
          "choice": "Off",
          "description": "VersionMajor / VersionPrefix / PackageVersion in the class library csproj. Default. No Nerdbank.GitVersioning package.",
          "displayName": "Off (VersionPrefix in the library project)"
        },
        {
          "choice": "Project",
          "description": "Add Nerdbank.GitVersioning with version.json in this library's Properties folder. Every create; paths do not collide.",
          "displayName": "Properties/version.json"
        },
        {
          "choice": "Repo",
          "description": "Add Nerdbank.GitVersioning using a repository-root version.json. The file is written only on a first create (--InitAllRepoItems or Visual Studio root items). Later libraries pass --NerdbankGitVersioning Repo without Init*.",
          "displayName": "Repository version.json"
        }
      ]
    },
    "UseNerdbankGitVersioning": {
      "type": "computed",
      "value": "(NerdbankGitVersioning == \"Project\" || NerdbankGitVersioning == \"Repo\")"
    },
    "WriteRepoVersionJson": {
      "type": "computed",
      "value": "(NerdbankGitVersioning == \"Repo\") && (InitRepoItems != \"None\") && (InitAllRepoItems || (InitRepoItems == \"Readme\") || (InitRepoItems == \"AIReleaseCheckpoint\") || (InitRepoItems == \"GitAttributes\") || (InitRepoItems == \"RepoLicense\"))"
    },
    // Library-only. Default off. First real build writes Properties/PublicAPI
    // baseline files if they are missing. Not a repository-root Init* item.
    "PublicApiAnalyzers": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "description": "Add Microsoft.CodeAnalysis.PublicApiAnalyzers to the class library. The first real build writes Properties/PublicAPI baseline files if they are missing. Test and benchmark projects are not affected.",
      "displayName": "Public API analyzers"
    },
    // Multi-choice. Default empty/None. Same DocTemplate.html seed, two
    // destinations. Package is per library (no combo collision). Repository
    // is repo-root documentation/ and collides on a later library (Exit 73).
    // Not part of InitAllRepoItems. Do not vendor the 25-file site here:
    // bootstrap follows DocTemplate.html and takes the versions it pins then.
    "DocumentationTemplate": {
      "type": "parameter",
      "datatype": "choice",
      "allowMultipleValues": true,
      "enableQuotelessLiterals": true,
      "isRequired": false,
      "defaultValue": "",
      "description": "Optional offline documentation template (DocTemplate.html). Package writes it under this library's NugetAssets/documentation (packed with the nupkg). Repository writes it under repo-root documentation/ (first create only). None writes nothing. Bootstrap and mini docs are a checkpoint task, not generate-time.",
      "displayName": "Documentation template",
      "choices": [
        {
          "choice": "None",
          "description": "Do not add a documentation template.",
          "displayName": "None"
        },
        {
          "choice": "Package",
          "description": "Add DocTemplate.html under this library's NugetAssets/documentation. Every create; paths do not collide. Packed with the nupkg.",
          "displayName": "NuGet package docs (NugetAssets/documentation)"
        },
        {
          "choice": "Repository",
          "description": "Add DocTemplate.html under documentation/ at the repository root. First create only; a later library in the same folder that selects this again is Exit 73.",
          "displayName": "Repository docs (documentation/)"
        }
      ]
    },
    "WritePackageDocTemplate": {
      "type": "computed",
      "value": "(DocumentationTemplate == \"Package\") && (DocumentationTemplate != \"None\")"
    },
    "WriteRepoDocTemplate": {
      "type": "computed",
      "value": "(DocumentationTemplate == \"Repository\") && (DocumentationTemplate != \"None\")"
    },
    // Project / NuGet license. Single choice. MIT first and default.
    // Standard licenses: PackageLicenseExpression; License.txt on disk only
    // (not packed — NU5033 if combined with PackageLicenseFile).
    // Custom: copyright-only License.txt packed as PackageLicenseFile.
    // Repo root LICENSE is InitRepoItems RepoLicense or InitAllRepoItems, not this dropdown.
    "ProjectLicense": {
      "type": "parameter",
      "datatype": "choice",
      "isRequired": false,
      "defaultValue": "MIT",
      "description": "License for the class library. Default MIT. Standards set PackageLicenseExpression. Custom packs License.txt. The LICENSE file at repository root copies this license.",
      "displayName": "Project license",
      "choices": [
        {
          "choice": "MIT",
          "description": "MIT. PackageLicenseExpression MIT. License.txt on disk only.",
          "displayName": "MIT"
        },
        {
          "choice": "BSD3Clause",
          "description": "BSD 3-Clause. PackageLicenseExpression BSD-3-Clause. License.txt on disk only.",
          "displayName": "BSD 3-Clause"
        },
        {
          "choice": "Apache2",
          "description": "Apache 2.0. PackageLicenseExpression Apache-2.0. License.txt on disk only.",
          "displayName": "Apache 2.0"
        },
        {
          "choice": "Custom",
          "description": "Copyright only (all rights reserved until you add terms). Writes License.txt and packs it as PackageLicenseFile.",
          "displayName": "Custom (License.txt)"
        }
      ]
    },
    // Library-only .project.editor.globalconfig via GlobalAnalyzerConfigFiles.
    // Default on. The file is a VS-exported style dump, not a build-fail
    // probe. Wire it before ImportSdkTargets; EnforceCodeStyleInBuild is
    // required or the file stays IDE-only.
    "ProjectEditorGlobalConfig": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "true",
      "description": "Add editor and analyzer rules beside the library project and apply them to that project in the IDE and on build. Test and benchmark projects are not affected.",
      "displayName": "Code style rules for library project"
    },
    // These options affect only the generated test project; the library remains free of test tooling.
    "CoverletMSBuild": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "true",
      "description": "Add a coverlet code coverage to the test project.",
      "displayName": "Add a coverlet code coverage to the test project."
    },
    "ReportGenerator": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "true",
      "description": "Add ReportGenerator for the coverlet output.",
      "displayName": "Add ReportGenerator for the coverlet output."
    },
    // Keeps BenchmarkDotNet isolated in an optional executable project.
    "BenchmarkProject": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "description": "Add an optional BenchmarkDotNet console project.",
      "displayName": "Add optional BenchmarkDotNet console project"
    }
  },
  // Registers XML-style conditionals for extensions that hosts do not always
  // treat the same as the built-in XML/.md processor. Tokens must sit on their
  // own lines because wholeLine is true. .targets is required so UseWebSdk can
  // pick Sdk.targets inside Build/ImportSdkTargets.targets at generate time.
  "specialCustomOperations": {
    "**/*.slnx": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "<!--#if" ],
            "else": [ "<!--#else" ],
            "elseif": [ "<!--#elseif" ],
            "endif": [ "<!--#endif" ],
            "trim": true,
            "wholeLine": true,
            "evaluator": "C++"
          }
        }
      ]
    },
    "**/*.md": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "<!--#if" ],
            "else": [ "<!--#else" ],
            "elseif": [ "<!--#elseif" ],
            "endif": [ "<!--#endif" ],
            "trim": true,
            "wholeLine": true,
            "evaluator": "C++"
          }
        }
      ]
    },
    "**/*.targets": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "<!--#if" ],
            "else": [ "<!--#else" ],
            "elseif": [ "<!--#elseif" ],
            "endif": [ "<!--#endif" ],
            "trim": true,
            "wholeLine": true,
            "evaluator": "C++"
          }
        }
      ]
    }
  },
  // Sources: optional files plus solution placement.
  // The template always starts from ClassLibrary.generated.slnx at the
  // template root. Paths inside that file are switched with <!--#if
  // (PlaceSolutionInSolutionFolder) --> (sln-folder-relative vs repo-relative).
  //
  // true  → rename to src/sln/ClassLibrary/ClassLibrary.slnx (CLI and VS).
  // false + CLI → rename to ClassLibrary.slnx at repo root.
  // false + VS  → no rename; file stays ClassLibrary.generated.slnx so it
  //   does not collide with Visual Studio's {Name}.slnx at the same folder.
  "sources": [
    {
      "modifiers": [
        {
          "condition": "((InitRepoItems == \"None\") || ((InitAllRepoItems == false) && (InitRepoItems != \"Readme\")))",
          "exclude": [
            "README.md"
          ]
        },
        {
          "condition": "((InitRepoItems == \"None\") || ((InitAllRepoItems == false) && (InitRepoItems != \"AIReleaseCheckpoint\")))",
          "exclude": [
            "TEMPLATE-AI-RELEASE-CHECKPOINT.md"
          ]
        },
        {
          "condition": "((InitRepoItems == \"None\") || ((InitAllRepoItems == false) && (InitRepoItems != \"GitAttributes\")))",
          "exclude": [
            ".gitattributes"
          ]
        },
        {
          "condition": "(BenchmarkProject == false)",
          "exclude": [
            "src/prj/ClassLibrary.Benchmark/ClassLibrary.Benchmark.csproj",
            "src/prj/ClassLibrary.Benchmark/Program.cs",
            "src/prj/ClassLibrary.Benchmark/.gitignore"
          ]
        },
        {
          "condition": "(ProjectEditorGlobalConfig == false)",
          "exclude": [
            "src/prj/ClassLibrary/.project.editor.globalconfig"
          ]
        },
        {
          "condition": "(NerdbankGitVersioning != \"Repo\")",
          "exclude": [
            "src/prj/ClassLibrary/Build/NerdbankRepositoryVersion.targets",
            "src/prj/ClassLibrary/Build/Nerdbank.version.json"
          ]
        },
        {
          "condition": "(PublicApiAnalyzers == false)",
          "exclude": [
            "src/prj/ClassLibrary/Build/InitializePublicApi.targets"
          ]
        },
        {
          "exclude": [
            "VersioningAssets/**",
            "DocumentationAssets/**"
          ]
        },
        {
          "condition": "(PlaceSolutionInSolutionFolder)",
          "rename": {
            "ClassLibrary.generated.slnx": "src/sln/ClassLibrary/ClassLibrary.slnx"
          }
        },
        {
          "condition": "(PlaceSolutionInSolutionFolder == false)",
          "exclude": [
            "src/sln/ClassLibrary/.gitignore"
          ]
        },
        {
          "condition": "((PlaceSolutionInSolutionFolder == false) && IsCliHost)",
          "rename": {
            "ClassLibrary.generated.slnx": "ClassLibrary.slnx"
          }
        }
      ]
    },
    {
      "source": "./VersioningAssets/",
      "target": "./",
      "condition": "WriteRepoVersionJson"
    },
    {
      "source": "./VersioningAssets/",
      "target": "./src/prj/ClassLibrary/Properties/",
      "condition": "(NerdbankGitVersioning == \"Project\")"
    },
    {
      "source": "./DocumentationAssets/",
      "target": "./src/prj/ClassLibrary/NugetAssets/documentation/",
      "condition": "WritePackageDocTemplate"
    },
    {
      "source": "./DocumentationAssets/",
      "target": "./documentation/",
      "condition": "WriteRepoDocTemplate"
    },
    {
      "source": "./src/prj/ClassLibrary/NugetAssets/",
      "target": "./",
      "condition": "((InitRepoItems != \"None\") && (InitAllRepoItems || (InitRepoItems == \"RepoLicense\")))",
      "modifiers": [
        {
          "exclude": [
            "Readme.md",
            "ReleaseNotes.txt",
            "Icon-128x128.png"
          ]
        },
        {
          "rename": {
            "License.txt": "LICENSE"
          }
        }
      ]
    }
  ],
  // Host bookkeeping only. Readme is index 0 for the VS open-file post action.
  // Solution paths are the names AFTER source rename, BEFORE sourceName replace.
  // The false+CLI actual file is ClassLibrary.slnx; primaryOutputs still names
  // the pre-CLI-rename .generated path, matching ClassLibrarySlim.
  "primaryOutputs": [
    {
      "path": "src/sln/ClassLibrary/Readme.md"
    },
    {
      "condition": "(PlaceSolutionInSolutionFolder)",
      "path": "src/sln/ClassLibrary/ClassLibrary.slnx"
    },
    {
      "condition": "(PlaceSolutionInSolutionFolder == false)",
      "path": "ClassLibrary.generated.slnx"
    }
  ],
  // Visual Studio only. CLI ignores open-file and we skip display actions there.
  // 84C0DA21 opens the sln readme. AC1156F7 is a message box after create
  // (not run-script; that dialog appeared before create).
  "postActions": [
      {
        "condition": "(HostIdentifier == \"vs\")",
        "description": "Opens Readme.md in the editor",
        "manualInstructions": [ ],
        "actionId": "84C0DA21-51C8-4541-9940-6CA19AF04EE6",
        "args": {
          "files": "0"
        },
        "continueOnError": true
      },
      {
        "condition": "(HostIdentifier == \"vs\" && PlaceSolutionInSolutionFolder)",
        "description": "Finish the repository layout",
        "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
        "manualInstructions": [
          {
            "text": "Close Visual Studio, open the .slnx under src/sln/, and delete the extra .slnx Visual Studio created in the repository root."
          }
        ],
        "continueOnError": true
      },
      {
        "condition": "(HostIdentifier == \"vs\" && (PlaceSolutionInSolutionFolder == false))",
        "description": "Finish the repository layout",
        "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
        "manualInstructions": [
          {
            "text": "Visual Studio created a conventional root .slnx. Open the .generated.slnx in the repository root for the template layout (includes sln). Delete the extra conventional .slnx if you do not need it."
          }
        ],
        "continueOnError": true
      }
  ]
}
