<Project>
  <!--
    NuGet auto-imports this file into every PackageReference consumer csproj
    (and anything that csproj imports, including Directory.Build.props/targets).
    UsingTask is the function surface. Invoke tasks from this file, from
    build/__SourceName__.targets, from the consumer csproj, or from Directory.Build.targets.
  -->
  <PropertyGroup>
    <_TaskFolder>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', 'tasks', 'netstandard2.0'))</_TaskFolder>
    <_TaskAssembly>$([MSBuild]::NormalizePath('$(_TaskFolder)', '$(MSBuildThisFileName).dll'))</_TaskAssembly>
  </PropertyGroup>
  <UsingTask TaskName="__SourceName__.AddTask" AssemblyFile="$(_TaskAssembly)" />
  <UsingTask TaskName="__SourceName__.TaskNodeTask" AssemblyFile="$(_TaskAssembly)" />
  <UsingTask TaskName="__SourceName__.HomeTask" AssemblyFile="$(_TaskAssembly)" />
  <UsingTask TaskName="__SourceName__.DumpEnvVarsTask" AssemblyFile="$(_TaskAssembly)" />

  <!-- Sample csproj extension: properties on the consuming project before CoreCompile. -->
  <!-- DumpEnvVarsTask and AddTask stay registered; call them from a consumer target when needed. -->
  <Target Name="__SourceName__PopulateTaskProperties" BeforeTargets="CoreCompile">
    <HomeTask>
      <Output TaskParameter="Home" PropertyName="HomeDirectory" />
    </HomeTask>
    <TaskNodeTask>
      <Output TaskParameter="TaskNodeDir" PropertyName="TaskNodeDirectory" />
      <Output TaskParameter="TaskNodeFile" PropertyName="TaskNodeLocation" />
    </TaskNodeTask>
  </Target>
</Project>
