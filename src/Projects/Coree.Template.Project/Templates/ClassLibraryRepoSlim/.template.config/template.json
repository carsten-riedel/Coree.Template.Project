{
  "$schema": "http://json.schemastore.org/template",
  "author": "Carsten Riedel",
  // Opts Visual Studio into category display in the New Project dialog
  "classifications": [ "Common", "dotnet", "Windows", "Linux", "macOS", "ClassLibrary", "Library", "Coree", "ClassLibraryRepoSlim" ],
  "identity": "CoreeTemplatesProjectClassLibraryRepoSlim",
  // Displayname is used in the New Project dialog and in the dotnet new list output.
  "name": ".NET Class library Repo Slim",
  "shortName": "classlibreposlim-coree",
  "tags": {
    "language": "C#",
    "type": "solution",
    // Opts Visual Studio into its solution-template UI instead of the project-template UI.
    "editorTreatAs": "solution"
  },
  "defaultName": "Organization.Domain.ClassLibrary", // Organization.Domain.Functionality
  "sourceName": "ClassLibrary", // Matching nameingscheme csproj and namespace
  // Visual Studio creates the outer solution directory; true would add another name directory.
  "preferNameDirectory": false,
  "symbols": {
    // HostIdentifier is bound by the template host (dotnetcli, vs, …).
    // Default "dotnetcli" so CLI-only dry runs still evaluate CLI rename rules.
    "HostIdentifier": {
      "type": "bind",
      "binding": "host:HostIdentifier",
      "defaultValue": "dotnetcli"
    },
    // Repo-level files that would collide on a 1:n split into the same output
    // (currently only README.md). CLI default is off so later libraries skip
    // them without --force. Visual Studio checks the box via ide.host.json
    // defaultValue true (first-create / hold-still path).
    "InitDefaultRepoItems": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "description": "Add repository-level files such as the root README.md. Enable on the first solution in a new repository.",
      "displayName": "Initialize default repository items"
    },
    // Where the TEMPLATE solution file is written. Default true: src/*.slnx
    // (CLI has only that file). Visual Studio always also writes a root .slnx;
    // when this is true those two files do not collide (different folders).
    // When false the template solution must sit at repo root, which WOULD
    // collide with Visual Studio's conventional {Name}.slnx — see sources
    // rename and ClassLibrary.generated.slnx (same trick as ClassLibrarySlim).
    "PlaceSolutionInSrc": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "true",
      "description": "Place the template solution under src/. Turn off to place it at the repository root.",
      "displayName": "Place solution under src/"
    },
    // True for dotnet new / preview CLI. Used so only CLI renames
    // .generated.slnx → ClassLibrary.slnx at repo root. Visual Studio keeps
    // the .generated name and therefore does not overwrite its own root .slnx.
    "IsCliHost": {
      "type": "computed",
      "value": "(HostIdentifier == \"dotnetcli\" || HostIdentifier == \"dotnetcli-preview\")"
    },
    // User-selectable target frameworks. Multiple values are supported for multi-targeting.
    "TargetFrameworks": {
      "type": "parameter",
      "description": "The target framework for the project TargetFrameworks property.",
      "datatype": "choice",
      "allowMultipleValues": true,
      "enableQuotelessLiterals": true,
      "choices": [
        {
          "choice": "net8.0",
          "description": "Target net8.0",
          "displayName": ".NET 8.0"
        },
        {
          "choice": "net9.0",
          "description": "Target net9.0",
          "displayName": ".NET 9.0"
        },
        {
          "choice": "net10.0",
          "description": "Target net10.0",
          "displayName": ".NET 10.0"
        }
      ],
      "defaultValue": "net8.0|net10.0"
    },
    // Uses the ASP.NET Core Web SDK for the library while test and benchmark projects keep their existing project roles.
    "UseWebSdk": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "description": "Use Microsoft.NET.Sdk.Web instead of Microsoft.NET.Sdk for the class library project.",
      "displayName": "Use the ASP.NET Core Web SDK"
    },
    // Converts the selected framework values to the semicolon-separated MSBuild list.
    "TargetFrameworksValue": {
      "type": "generated",
      "generator": "join",
      "replaces": "__TargetFrameworks__",
      "parameters": {
        "symbols": [
          {
            "type": "ref",
            "value": "TargetFrameworks"
          }
        ],
        "separator": ";",
        "removeEmptyValues": true
      }
    },
    // Resolves the highest selected framework to one value for single-framework paths and filenames.
    "TargetFrameworkValue": {
      "type": "generated",
      "generator": "switch",
      "replaces": "__TargetFramework__",
      "parameters": {
        "datatype": "string",
        "cases": [
          {
            "condition": "(TargetFrameworks == \"net10.0\")",
            "value": "net10.0"
          },
          {
            "condition": "(TargetFrameworks == \"net9.0\")",
            "value": "net9.0"
          },
          {
            "condition": "(TargetFrameworks == \"net8.0\")",
            "value": "net8.0"
          }
        ]
      }
    },
    // Package metadata parameters replace their matching placeholders in the project and package assets.
    "PackageAuthor": {
      "type": "parameter",
      "dataType": "string",
      "replaces": "MyAuthor",
      "description": "The nuget package author of your project.",
      "displayName": "Package author",
      "isRequired": "true"
    },
    "PackageCopyrightHolder": {
      "type": "parameter",
      "dataType": "string",
      "defaultValue": "",
      "replaces": "MyCopyrightHolder",
      "description": "Copyright holder for the package and license. Defaults to the package author when empty.",
      "displayName": "Copyright holder"
    },
    "PackageCopyrightHolderIsSet": {
      "type": "computed",
      "value": "(PackageCopyrightHolder != \"\")"
    },
    "PackageCopyrightHolderIsOrganization": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "description": "Set when the copyright holder is an organization. Controls NuGet Company metadata only.",
      "displayName": "Copyright holder is an organization"
    },
    // Date generators replace fixed template placeholders in project metadata and package assets.
    "copyrightYear": {
      "type": "generated",
      "generator": "now",
      "replaces": "1975",
      "parameters": {
        "format": "yyyy"
      }
    },
    "datenowsort": {
      "type": "generated",
      "generator": "now",
      "replaces": "1975-01-01",
      "parameters": {
        "format": "yyyy-MM-dd"
      }
    },
    "PackageDescription": {
      "type": "parameter",
      "dataType": "string",
      "defaultValue": "PackageDescription",
      "replaces": "PackageDescription",
      "description": "The nuget package description of your project.",
      "displayName": "Package description"
    },
    // These options affect only the generated test project; the library remains free of test tooling.
    "CoverletMSBuild": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "true",
      "description": "Add a coverlet code coverage to the test project.",
      "displayName": "Add a coverlet code coverage to the test project."
    },
    "ReportGenerator": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "true",
      "description": "Add ReportGenerator for the coverlet output.",
      "displayName": "Add ReportGenerator for the coverlet output."
    },
    // Keeps BenchmarkDotNet isolated in an optional executable project.
    "BenchmarkProject": {
      "type": "parameter",
      "dataType": "bool",
      "defaultValue": "false",
      "description": "Add an optional BenchmarkDotNet console project.",
      "displayName": "Add optional BenchmarkDotNet console project"
    }
  },
  // Registers XML-style conditionals for extensions that hosts do not always
  // treat the same as the built-in XML/.md processor. Tokens must sit on their
  // own lines because wholeLine is true.
  "specialCustomOperations": {
    "**/*.slnx": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "<!--#if" ],
            "else": [ "<!--#else" ],
            "elseif": [ "<!--#elseif" ],
            "endif": [ "<!--#endif" ],
            "trim": true,
            "wholeLine": true,
            "evaluator": "C++"
          }
        }
      ]
    },
    "**/*.md": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "<!--#if" ],
            "else": [ "<!--#else" ],
            "elseif": [ "<!--#elseif" ],
            "endif": [ "<!--#endif" ],
            "trim": true,
            "wholeLine": true,
            "evaluator": "C++"
          }
        }
      ]
    }
  },
  // Sources: optional files plus solution placement.
  // The template always starts from ClassLibrary.generated.slnx at the
  // template root. Paths inside that file are switched with <!--#if
  // (PlaceSolutionInSrc) --> (src-relative vs repo-relative).
  //
  // PlaceSolutionInSrc true  → rename to src/ClassLibrary.slnx (CLI and VS).
  // PlaceSolutionInSrc false + CLI → rename to ClassLibrary.slnx at repo root.
  // PlaceSolutionInSrc false + VS  → no rename; file stays
  //   ClassLibrary.generated.slnx so it does not collide with Visual Studio's
  //   {Name}.slnx at the same folder.
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(InitDefaultRepoItems == false)",
          "exclude": [
            "README.md"
          ]
        },
        {
          "condition": "(BenchmarkProject == false)",
          "exclude": [
            "src/prj/ClassLibrary.Benchmark/ClassLibrary.Benchmark.csproj",
            "src/prj/ClassLibrary.Benchmark/Program.cs",
            "src/prj/ClassLibrary.Benchmark/.gitignore"
          ]
        },
        {
          "condition": "(PlaceSolutionInSrc)",
          "rename": {
            "ClassLibrary.generated.slnx": "src/ClassLibrary.slnx"
          }
        },
        {
          "condition": "((PlaceSolutionInSrc == false) && IsCliHost)",
          "rename": {
            "ClassLibrary.generated.slnx": "ClassLibrary.slnx"
          }
        }
      ]
    }
  ],
  // Host bookkeeping only. Readme is index 0 for the VS open-file post action.
  // Solution paths are the names AFTER source rename, BEFORE sourceName replace.
  // The false+CLI actual file is ClassLibrary.slnx; primaryOutputs still names
  // the pre-CLI-rename .generated path, matching ClassLibrarySlim.
  "primaryOutputs": [
    {
      "path": "src/wrk/ClassLibrary/Readme.md"
    },
    {
      "condition": "(PlaceSolutionInSrc)",
      "path": "src/ClassLibrary.slnx"
    },
    {
      "condition": "(PlaceSolutionInSrc == false)",
      "path": "ClassLibrary.generated.slnx"
    }
  ],
  // Visual Studio only. CLI ignores open-file and we skip display actions there.
  // 84C0DA21 opens the wrk readme. AC1156F7 is a message box after create
  // (not run-script; that dialog appeared before create).
  "postActions": [
      {
        "condition": "(HostIdentifier == \"vs\")",
        "description": "Opens Readme.md in the editor",
        "manualInstructions": [ ],
        "actionId": "84C0DA21-51C8-4541-9940-6CA19AF04EE6",
        "args": {
          "files": "0"
        },
        "continueOnError": true
      },
      {
        "condition": "(HostIdentifier == \"vs\" && PlaceSolutionInSrc)",
        "description": "Finish the repository layout",
        "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
        "manualInstructions": [
          {
            "text": "Close Visual Studio, open the .slnx under src/, and delete the extra .slnx Visual Studio created in the repository root."
          }
        ],
        "continueOnError": true
      },
      {
        "condition": "(HostIdentifier == \"vs\" && (PlaceSolutionInSrc == false))",
        "description": "Finish the repository layout",
        "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
        "manualInstructions": [
          {
            "text": "Visual Studio created a conventional root .slnx. Open the .generated.slnx in the repository root for the template layout (includes wrk). Delete the extra conventional .slnx if you do not need it."
          }
        ],
        "continueOnError": true
      }
  ]
}
