<Project>
  <!--
    Analyzer nupkgs put the assembly under analyzers/dotnet/cs, not lib/.
    IncludeBuildOutput is false on the csproj so the SDK does not also write lib/{tfm}/.
    This target runs during pack of netstandard2.0.
    AnalyzerPackage/__SourceName__.props is the consumer MSBuild surface
    (severity and additional-file include/exclude glob properties).
  -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackAsAnalyzer</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="$(AnalyzerPackageSourcePath)\__SourceName__.props" />
    <!-- Show one physical copy in Visual Studio under AnalyzerPackage; the second package projection stays hidden. -->
    <None Include="$(AnalyzerPackageSourcePath)\__SourceName__.props" Pack="true" PackagePath="build\" Visible="true" />
    <None Include="$(AnalyzerPackageSourcePath)\__SourceName__.props" Pack="true" PackagePath="buildTransitive\" Visible="false" />
  </ItemGroup>
  <Target Name="PackAsAnalyzer">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetPath)" PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="$(TargetDir)$(TargetName).xml" PackagePath="analyzers/dotnet/cs" Condition="Exists('$(TargetDir)$(TargetName).xml')" />
    </ItemGroup>
  </Target>
</Project>
