<Project Sdk="Microsoft.NET.Sdk">

  <!-- Same props the nupkg imports for PackageReference consumers. -->
  <Import Project="..\ClassLibrary\Build\ClassLibrary.props" />

  <!-- Startable console and compile target for the analyzer DebugRoslynComponent profile. Not packed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>__TargetFramework__</TargetFramework>
  </PropertyGroup>

  <!-- C# language features and debugging configuration -->
  <PropertyGroup>
    <!--#if (CSharpProjectOptions == "DisableImplicitUsings") -->
    <ImplicitUsings>disable</ImplicitUsings>
    <!--#else -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!--#endif -->
    <!--#if (CSharpProjectOptions == "Nullable") -->
    <Nullable>enable</Nullable>
    <!--#else -->
    <Nullable>disable</Nullable>
    <!--#endif -->
    <!--#if (CSharpProjectOptions == "DebugEmbedded") -->
    <DebugType>embedded</DebugType>
    <!--#else -->
    <DebugType>none</DebugType>
    <!--#endif -->
    <!--#if (CSharpProjectOptions == "LangLatest") -->
    <LangVersion>latest</LangVersion>
    <!--#else -->
    <LangVersion>default</LangVersion>
    <!--#endif -->
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <IsTestProject>false</IsTestProject>
    <PackAsTool>false</PackAsTool>
  </PropertyGroup>

  <!-- Sample analyzer severity: warning (default), error, message, or off. -->
  <!-- Additional files: semicolon-separated globs relative to this project. Empty disables that scan. -->
  <PropertyGroup>
    <EmDashAnalyzerSeverity>warning</EmDashAnalyzerSeverity>
    <SmartQuotesAnalyzerSeverity>warning</SmartQuotesAnalyzerSeverity>
    <EmDashAnalyzerAdditionalFiles>*.txt;*.csproj</EmDashAnalyzerAdditionalFiles>
    <SmartQuotesAnalyzerAdditionalFiles>*.txt;*.csproj</SmartQuotesAnalyzerAdditionalFiles>
  </PropertyGroup>

  <!-- Load the in-repo analyzer at compile time. Do not reference it as a library. -->
  <ItemGroup>
    <ProjectReference Include="..\ClassLibrary\ClassLibrary.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Additional-file sample: 1—2 and “hello”. -->
  <ItemGroup>
    <None Include="SampleTypography.txt" />
  </ItemGroup>

  <!-- Keep Git configuration on disk without showing it as a project item -->
  <ItemGroup>
    <None Remove=".gitignore" />
  </ItemGroup>

</Project>
